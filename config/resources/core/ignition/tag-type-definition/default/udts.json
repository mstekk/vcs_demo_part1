      {
        "valueSource": "memory",
        "eventScripts": [
          {
            "eventid": "valueChanged",
            "script": "\tfrom java.util import ArrayList\n\tfrom java.util import Date\n\tfrom java.util import Calendar\n\tmonths \u003d []\n\tdate \u003d system.tag.readBlocking([\"[~]autoReportGeneration/endDate\"])\n\tfor date1 in date:\n\t\tcalendar \u003d Calendar.getInstance()\n\t\tmonthNumber \u003d calendar.get(Calendar.MONTH)\n\t\tmonths.append(monthNumber)\n\t\t\n\tmonth_names \u003d [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"]\n\tmonth \u003d month_names[monthNumber]\n\t\n\ttitle \u003d str(system.tag.readBlocking([\"[.]reportTitle\"])[0].value)\n\treportPath \u003d str(system.tag.readBlocking([\"[.]reportPath\"])[0].value)\n\treportSource \u003d str(system.tag.readBlocking([\"[~]autoReportGeneration/reportSource\"])[0].value)\n\tinterval \u003d int(system.tag.readBlocking([\"[~]autoReportGeneration/intervalValue\"])[0].value)\n\tstartDate \u003d system.tag.readBlocking([\"[~]autoReportGeneration/startDate\"])\n\tendDate \u003d system.tag.readBlocking([\"[~]autoReportGeneration/endDate\"])\n\tcolMinShow \u003d bool(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colMinShow\"])[0].value)\n\tcolMinWidth \u003d int(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colMinWidth\"])[0].value)\n\tcolMaxShow \u003d bool(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colMaxShow\"])[0].value)\n\tcolMaxWidth \u003d int(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colMaxWidth\"])[0].value)\n\tcolAvgShow \u003d bool(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colAvgShow\"])[0].value)\n\tcolAvgWidth \u003d int(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colAvgWidth\"])[0].value)\n\tcolTotalShow \u003d bool(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colTotalShow\"])[0].value)\n\tcolTotalWidth \u003d int(system.tag.readBlocking([\"[~]autoReportGeneration/columns/colTotalWidth\"])[0].value)\n\treportParams \u003d {\"StartDate\":startDate, \"EndDate\":endDate, \"Title\":title, \"Interval\":interval, \"ReportPath\":reportPath, \"colMinShow\":colMinShow, \"colMinWidth\":colMinWidth, \"colMaxShow\":colMaxShow, \"colMaxWidth\":colMaxWidth, \"colAvgShow\":colAvgShow, \"colAvgWidth\":colAvgWidth, \"colTotalShow\":colTotalShow, \"colTotalWidth\":colTotalWidth}\n\tfileName \u003d str(system.tag.readBlocking([\"[~]autoReportGeneration/dateNow\"]))+\" \"+title+\" Report.pdf\"\n\tbody \u003d \"See attached report file for \"+ title + \" for the month of \" + month + \".\"\n\tsettings \u003d {\"useRoles\":True, \"roles\":[\"SARI Report\"], \"smtpServerName\":\"JCSD Outlook\", \"from\":\"SCADA5@jcsd.us\", \"subject\":\"Monthly Report (\"+ month +\") - \" +title, \"body\":body, \"attachmentName\": fileName}\n\n\tif previousValue and (previousValue.getValue() !\u003d currentValue.getValue()):\n\t\tif currentValue.getValue() \u003d\u003d True:\n\t\t\tsystem.report.executeAndDistribute(path\u003d reportSource, project\u003d\"JCSD\",parameters\u003dreportParams, action\u003d\"email\", actionSettings\u003dsettings)\n\tprint reportSource\n\tprint reportParams\n\tprint settings"
          }
