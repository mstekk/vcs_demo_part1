  {
    "eventScripts": [
      {
        "eventid": "valueChanged",
        "script": "\t#if True\t\u003d\u003d True:\nif previousValue.value \u003d\u003d True and currentValue.value \u003d\u003d False:\n\tpaths \u003d [\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-1-100\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-2-100\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-3-100\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-CLS601\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-D-PACKER\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-DEADHEAD\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-E3\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-E60\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-GUPPY\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-L-PACKER\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-M-PACKER\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-NC175\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-NE175\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-NW175\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-SE175\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-SW175\",\n\t\t\t\"Test SCADA Integrations/Priority03/LU-GRA-RM5-PMP-SET-TO-W60\"]\n\t\t\t\t\n\tvalues \u003d system.tag.readAll(paths)\n\t\n\t#Check which Product is being made\n\tfor index in range(len(paths)):\n\t\t#print values[index].value\n\t\tif values[index].value \u003d\u003d True:\n\t\t\tRowMatch \u003d index\n\t\n\t#later, for efficiency, put this as last value in list and reference using -1 index\n\t#values[-1].value\n\tValueRecentSP \u003d system.tag.read(\"Test SCADA Integrations/Priority03/Float_Test_SP\").value\n\t\n\t#Write ValueRecentSP  to col 1 of the Product\u0027s row\n\t#RowMatch is row#\n\t#ValueRecentSP gets written to col 1\n\tdata \u003d system.tag.read(\"Test SCADA Integrations/Priority03/Product_Recent_Setpoints\").value\n\t\n\t#check if col 1 is already the same value\n\t#print \"Value at RowMatch, 1: \" + str(data.getValueAt(RowMatch,1))\n\tif ValueRecentSP !\u003d data.getValueAt(RowMatch,1):\n\t\t#if it\u0027s a new value, shift everything\n\t\t#move col 2 to 3\n\t\tnewCol_3 \u003d data.getValueAt(RowMatch,2)\n\t\tdata \u003d system.dataset.setValue(data, RowMatch, 3, newCol_3)\n\t\t#move col 1 to 2\n\t\tnewCol_2 \u003d data.getValueAt(RowMatch,1)\n\t\tdata \u003d system.dataset.setValue(data, RowMatch, 2, newCol_2)\n\t\n\tdata \u003d system.dataset.setValue(data, RowMatch, 1, ValueRecentSP)\n\t\n\t#for row in range(data.rowCount):\n\t#   for col in range(data.columnCount):\n\t#      print data.getValueAt(row, col)\n\t\n\t#Write Dataset back to Tag\n\tsystem.tag.write(\"Test SCADA Integrations/Priority03/Product_Recent_Setpoints\", data)"
      }
    ],
