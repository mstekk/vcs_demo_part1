                "onChange": {
                  "enabled": null,
                  "script": "\t# Reference to your pens array (adjust path if needed)\n\tpens \u003d self.props.pens\n\t\n\t# Defensive check\n\tif not pens:\n\t    return\n\t\n\tnewPens \u003d []\n\t\n\tfor pen in pens:\n\t    # Copy the pen so we don’t mutate original references\n\t    newPen \u003d dict(pen)\n\t\n\t    name \u003d newPen.get(\"name\", \"\")\n\t\n\t    # Remove everything from \"/\" onward\n\t    if \"/\" in name:\n\t        newPen[\"name\"] \u003d name.split(\"/\", 1)[0]\n\t\n\t    newPens.append(newPen)\n\t\n\t# Write back the modified array\n\tself.props.pens \u003d newPens"
                }
              }
