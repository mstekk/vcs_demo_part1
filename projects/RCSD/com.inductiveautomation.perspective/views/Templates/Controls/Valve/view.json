{
  "custom": {},
  "params": {
    "isModular": true
  },
  "propConfig": {
    "params.isModular": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 300,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "style": {
            "borderBottomStyle": "solid",
            "borderBottomWidth": 1,
            "marginLeft": 20,
            "marginRight": 20
          },
          "text": "CONTROL",
          "textStyle": {
            "classes": "Text/Labels",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "HOA"
            },
            "position": {
              "basis": "50%"
            },
            "propConfig": {
              "props.defaultSelectedStyle.classes": {
                "binding": {
                  "config": {
                    "expression": "\u0027Text/Labels Theme/selected-\u0027+{session.props.theme}"
                  },
                  "type": "expr"
                }
              },
              "props.indicatorValue": {
                "binding": {
                  "config": {
                    "path": "this.props.controlValue"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "controlValue": 2,
              "defaultSelectedStyle": {},
              "defaultUnselectedStyle": {
                "classes": "Text/Labels"
              },
              "states": [
                {
                  "selectedStyle": {
                    "classes": ""
                  },
                  "text": "LOCAL",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 1
                },
                {
                  "selectedStyle": {
                    "classes": ""
                  },
                  "text": "OFF",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 0
                },
                {
                  "selectedStyle": {
                    "classes": ""
                  },
                  "text": "REMOTE",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 2
                }
              ],
              "style": {
                "marginRight": 5
              }
            },
            "type": "ia.input.multi-state-button"
          },
          {
            "meta": {
              "name": "Manual Auto"
            },
            "position": {
              "basis": "50%"
            },
            "propConfig": {
              "props.defaultSelectedStyle.classes": {
                "binding": {
                  "config": {
                    "expression": "\u0027Text/Labels Theme/selected-\u0027+{session.props.theme}"
                  },
                  "type": "expr"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "../HOA.props.indicatorValue"
                  },
                  "transforms": [
                    {
                      "expression": "{value}\u003d2",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.indicatorValue": {
                "binding": {
                  "config": {
                    "path": "this.props.controlValue"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "controlValue": 0,
              "defaultSelectedStyle": {},
              "defaultUnselectedStyle": {
                "classes": "Text/Labels"
              },
              "states": [
                {
                  "selectedStyle": {
                    "classes": ""
                  },
                  "text": "MANUAL",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 0
                },
                {
                  "selectedStyle": {
                    "classes": ""
                  },
                  "text": "AUTO",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 1
                }
              ],
              "style": {
                "marginLeft": 5
              }
            },
            "type": "ia.input.multi-state-button"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "130px",
          "shrink": 0
        },
        "props": {
          "style": {
            "marginBottom": 5,
            "marginLeft": 10,
            "marginRight": 10,
            "marginTop": 10
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Start Stop"
        },
        "position": {
          "basis": "70px"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.isModular"
              },
              "transforms": [
                {
                  "fallback": false,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": false
                    },
                    {
                      "input": false,
                      "output": true
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.defaultSelectedStyle.classes": {
            "binding": {
              "config": {
                "expression": "\u0027Text/Labels Theme/selected-\u0027+{session.props.theme}"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "path": "../FlexContainer/Manual Auto.props.indicatorValue"
              },
              "transforms": [
                {
                  "expression": "{value}\u003d0\r\n\u0026\u0026\r\n{../FlexContainer/Manual Auto.props.enabled}",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.indicatorValue": {
            "binding": {
              "config": {
                "path": "this.props.controlValue"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "controlValue": 0,
          "defaultSelectedStyle": {},
          "defaultUnselectedStyle": {
            "classes": "Text/Labels"
          },
          "orientation": "row",
          "states": [
            {
              "selectedStyle": {
                "classes": ""
              },
              "text": "OPEN",
              "unselectedStyle": {
                "classes": ""
              },
              "value": 0
            },
            {
              "selectedStyle": {
                "classes": ""
              },
              "text": "CLOSE",
              "unselectedStyle": {
                "classes": ""
              },
              "value": 1
            }
          ],
          "style": {
            "marginBottom": 5,
            "marginLeft": 10,
            "marginRight": 10,
            "marginTop": 5
          }
        },
        "type": "ia.input.multi-state-button"
      },
      {
        "children": [
          {
            "meta": {
              "name": "SV_Label"
            },
            "position": {
              "basis": "20%"
            },
            "props": {
              "text": "SP:",
              "textStyle": {
                "classes": "Text/Labels",
                "marginRight": 5,
                "textAlign": "right"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SV"
            },
            "position": {
              "basis": "20%"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": ".../FlexContainer/HOA.props.indicatorValue"
                  },
                  "transforms": [
                    {
                      "expression": "{value}\u003d2",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "path": "parent.custom.setpoint"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "spinner": {
                "enabled": false
              },
              "style": {
                "borderBottomLeftRadius": 0,
                "borderBottomRightRadius": 0,
                "borderBottomStyle": "solid",
                "borderLeftStyle": "none",
                "borderRightStyle": "none",
                "borderTopStyle": "none",
                "classes": "Text/Setpoints",
                "textAlign": "center"
              }
            },
            "type": "ia.input.numeric-entry-field"
          },
          {
            "meta": {
              "name": "SV_Unit"
            },
            "position": {
              "basis": "15%"
            },
            "props": {
              "text": "%",
              "textStyle": {
                "classes": "Text/Units"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "PV_Label"
            },
            "props": {
              "style": {
                "marginRight": 5
              },
              "text": "PV:",
              "textStyle": {
                "classes": "Text/Labels"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "PV"
            },
            "props": {
              "text": 22,
              "textStyle": {
                "classes": "Text/ProcessVariable",
                "paddingRight": 5,
                "textAlign": "end"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SV_Unit_0"
            },
            "position": {
              "basis": "10%"
            },
            "props": {
              "text": "%",
              "textStyle": {
                "classes": "Text/Units"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Speed"
        },
        "position": {
          "basis": "40px"
        },
        "propConfig": {
          "custom.setpoint": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[RCSD]WTF/Anita-B-Smith/BS-V1/Value"
              },
              "type": "tag"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.isModular"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginBottom": 10,
            "marginLeft": 30,
            "marginRight": 10,
            "marginTop": 5,
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.tag.writeBlocking(\u0027[RCSD]WTF/Anita-B-Smith/BS-V1/Value\u0027, self.parent.parent.getChild(\"Speed\").getChild(\"SV\").props.value)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button_OK"
            },
            "position": {
              "basis": "50%"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": ".../Speed.custom.setpoint"
                  },
                  "transforms": [
                    {
                      "expression": "{value}!\u003d{.../Speed/SV.props.value}",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "primary": false,
              "style": {
                "marginRight": 5
              },
              "text": "OK"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.parent.parent.getChild(\"Speed\").getChild(\"SV\").props.value \u003d self.parent.parent.getChild(\"Speed\").custom.setpoint"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button_CANCEL"
            },
            "position": {
              "basis": "50%"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": ".../Speed.custom.setpoint"
                  },
                  "transforms": [
                    {
                      "expression": "{value}!\u003d{.../Speed/SV.props.value}",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "primary": false,
              "style": {
                "marginLeft": 5
              },
              "text": "CANCEL"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "OK"
        },
        "position": {
          "basis": "40px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.isModular"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginBottom": 10,
            "marginLeft": 10,
            "marginRight": 10,
            "marginTop": 5,
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}