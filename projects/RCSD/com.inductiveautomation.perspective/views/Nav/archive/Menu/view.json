{
  "custom": {},
  "params": {
    "icon": "rcsd/overview-system",
    "item": [
      {
        "icon": "material/dashboard",
        "instancePosition": {},
        "instanceStyle": {
          "classes": ""
        },
        "label": "Dashboard",
        "target": "value"
      },
      {
        "icon": "material/notification_important",
        "instancePosition": {},
        "instanceStyle": {
          "classes": ""
        },
        "label": "Alarms",
        "target": "value"
      },
      {
        "icon": "material/timeline",
        "instancePosition": {},
        "instanceStyle": {
          "classes": ""
        },
        "label": "Trend",
        "target": "value"
      }
    ],
    "label": "System Overview",
    "selected": "",
    "target": ""
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.item": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.target": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 125,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "30px"
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.params.icon"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "marginLeft": 5,
                "marginRight": 5,
                "overflow": "hidden"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "32px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.label"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Navigation",
                "overflow": "hidden"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Icon_0"
            },
            "position": {
              "basis": "30px"
            },
            "props": {
              "path": "material/keyboard_arrow_down",
              "style": {
                "overflow": "hidden"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif len(self.view.params.item) \u003e 0:\n\t\tif self.view.params.selected \u003d\u003d self.view.params.label:\n\t\t\tself.view.params.selected \u003d \"\"\n\t\t\tself.getChild(\"Icon_0\").props.path \u003d \"material/keyboard_arrow_down\"\n\t\telse:\n\t\t\tself.view.params.selected \u003d self.view.params.label\n\t\t\tself.getChild(\"Icon_0\").props.path \u003d \"material/keyboard_arrow_up\"\n\t\n\telse:\n\t\tself.getChild(\"Icon_0\").props.path \u003d \"material/keyboard_arrow_right\"\n\t\tsystem.perspective.navigate(self.view.params.target)"
              },
              "scope": "G",
              "type": "script"
            }
          },
          "system": {
            "onStartup": {
              "config": {
                "script": "\tif len(self.view.params.item) \u003e 0:\n\t\tself.getChild(\"Icon_0\").props.path \u003d \"material/keyboard_arrow_down\"\n\telse:\n\t\tself.getChild(\"Icon_0\").props.path \u003d \"material/keyboard_arrow_right\""
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Navigation",
            "cursor": "pointer",
            "overflow": "hidden",
            "paddingBottom": 10,
            "paddingTop": 10
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.selected"
              },
              "transforms": [
                {
                  "expression": "if({value}\u003d{view.params.label}, true, false)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.params.item"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "path": "Nav/Sub Menu",
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}