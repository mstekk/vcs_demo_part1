{"onStartup":"\tif 'viewCanvas' not in session.custom.keys():\n\t\tsession.custom['viewCanvas']={\"componentHover\": False} ","onBarcodeDataReceived":"\t","onBluetoothReceived":"\t","onAccelerometerDataReceived":"\t","onNdefDataReceived":"\t","messageHandlers":[{"name":"updateTPM","enabled":true,"script":"\timport os\n\timport json\n\tlogger = system.util.getLogger(\"FileSystemOpen\")\n\tdef read_json_file(file_path):\n\t    try:\n\t        with open(file_path, 'r') as file:\n\t            file_content = file.read()\n\t            data = file_content\n\t            return data\n\t    except IOError as e:\n\t        logger.warn(\"Error reading file: {}\".format(e))\n\t        return None\n\t    except ValueError as e:\n\t        logger.warn(\"Error decoding JSON: {}\".format(e))\n\t        return None\n\t        \n\tdirectory_path='{}{}'.format(basePath,'/savedFiles/ThirdPartyModules/TPM.json')\n\tjsonString= read_json_file(directory_path)\n\tdoc=system.util.jsonDecode(jsonString)"},{"name":"emailSent","enabled":true,"script":"\tsystem.perspective.sendMessage('emailSent', payload, scope='session')"},{"name":"sendingEmail","enabled":true,"script":"\t#system.util.sendMessage(project,'sendingEmail', {'session': session, 'sendTo': sendTo})\n\tsystem.perspective.sendMessage('sendingEmail', payload, scope='session')"}],"keyHandlers":[{"keyData":{"name":"[Control Prevent Default] C (keyDown)","enabled":true,"eventMode":"KEYDOWN","eventBound":"KEY","eventBoundKey":"C","eventBoundCode":"","regexPattern":"","regexWindow":1,"altEventModifier":false,"controlEventModifier":true,"shiftEventModifier":false,"metaEventModifier":false,"capturePhaseEventOption":false,"preventDefaultEventOption":true,"stopPropagationEventOption":false},"script":"\tsystem.perspective.sendMessage('keystroke', {'type':\"ctrlc\"},scope='session')"},{"keyData":{"name":"[Control Prevent Default] i (keyDown)","enabled":true,"eventMode":"KEYDOWN","eventBound":"KEY","eventBoundKey":"i","eventBoundCode":"","regex