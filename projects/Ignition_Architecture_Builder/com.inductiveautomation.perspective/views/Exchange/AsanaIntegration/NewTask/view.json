        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# Parameters\n\tself.custom.insertInitiated\u003dTrue\n\tself.custom.insertInitiatedTime\u003dsystem.date.now()\n\tself.props.style.backgroundColor\u003d\"yellow\"\n\tapi_token \u003d str(self.view.custom.settings.token)\n\tproject_id \u003d str(self.view.custom.settings.project)\n\tsection_id \u003d str(self.view.custom.settings.section)\n\t\n\ttask_name \u003d str(self.getSibling(\"TaskName\").props.text)\n\ttask_notes \u003d str(self.getSibling(\"TaskNote\").props.text)\n\treporter\u003d str(self.getSibling(\"Contact\").props.text)\n\t\n\tcustom_fields\u003d{}\n\tfields\u003dself.getSibling(\"FlexRepeater\").props.instances\n\tfor x in fields:\n\t\tif x[\u0027selected\u0027]!\u003d\u0027\u0027 and x[\u0027selected\u0027] is not None:\n\t\t\tif x[\u0027custom_field\u0027][\u0027type\u0027]\u003d\u003d\u0027multi_enum\u0027:\n\t\t\t\tselectOptions\u003d[]\n\t\t\t\tfor sel in x[\u0027selected\u0027]:\n\t\t\t\t\tselectOptions.append(str(sel))\n\t\t\t\tcustom_fields[str(x[\u0027custom_field\u0027][\u0027gid\u0027])]\u003dselectOptions\n\t\t\telse:\n\t\t\t\tcustom_fields[str(x[\u0027custom_field\u0027][\u0027gid\u0027])]\u003dstr(x[\u0027selected\u0027])\n\n\t# API endpoint\n\turl \u003d \"https://app.asana.com/api/1.0/tasks\"\n\t\n\t# Headers\n\theaders\u003d{\n\t\t\"accept\": \u0027application/json\u0027,\n\t\t\u0027content-type\u0027: \u0027application/json\u0027,\n\t\t\"authorization\": \u0027Bearer {}\u0027.format(api_token)\n\t}\n\t\n\t# Data\n\tdata \u003d {\n\t    \"data\": {\n\t        \"custom_fields\": custom_fields,\n\t        \"name\": task_name,\n\t        \"notes\": \u0027Reporter: {}\\n Page: {}\\n-------------------- \\n{}\u0027.format(reporter,self.page.props.path,task_notes),\n\t        \"projects\": [project_id],\n            \"followers\": [],\n            \"memberships\": [\n\t            {\n\t                \"project\": project_id,\n\t                \"section\": section_id\n\t            }\n\t            ]\n\t    }\n\t}\n\t# Convert data to JSON\n\timport json\n\tjson_data \u003d json.dumps(data)\n\t\n\t# Make the HTTP POST request\n\tresponse \u003d system.net.httpPost(url\u003d url, contentType\u003d\u0027application/json\u0027, postData\u003djson_data, headerValues\u003dheaders)\n\t\n\t# Print the response\n\tself.custom.InsertTaskResponse\u003djson.loads(response)\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "InsertTasks",
          "tooltip": {
            "text": "Task Insert Fail, Refresh and Try Again"
          }
        },
        "position": {
          "basis": "34px"
        },
        "propConfig": {
          "custom.link": {
            "binding": {
              "config": {
                "path": "this.custom.InsertTaskResponse.data"
              },
              "transforms": [
                {
                  "code": "\tif value is None:\n\t\treturn \"\"\n\treturn \"https://app.asana.com/0/{}/{}/f\".format(value[\u0027projects\u0027][0][\u0027gid\u0027],value[\u0027gid\u0027])",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "custom.modified": {
            "binding": {
              "config": {
                "path": "this.custom.InsertTaskResponse.data.modified_at"
              },
              "transforms": [
                {
                  "code": "\tif value is None:\n\t\treturn None\n\treturn system.date.parse(value+\"+0000\",\"yyyy-MM-dd\u0027T\u0027HH:mm:ss.SSS\u0027Z\u0027Z\")",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "custom.now": {
            "binding": {
              "config": {
                "expression": "dateArithmetic(now(),-3,\u0027seconds\u0027)"
              },
              "type": "expr"
            }
          },
          "custom.sec5": {
            "binding": {
              "config": {
                "struct": {
                  "modified": "{this.custom.modified}",
                  "now": "{this.custom.now}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value[\u0027now\u0027] is None or value[\u0027modified\u0027] is  None:\n\t\treturn False\n\t\n\ttry:\n\t\treturn system.date.isAfter(value[\u0027modified\u0027], value[\u0027now\u0027])\n\texcept:\n\t\treturn False",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            },
            "onChange": {
              "enabled": null,
              "script": "\ttry:\n\t\tif self.custom.sec5\u003d\u003dFalse:\n\t\t\tsystem.perspective.closeDock(\"bug\")\n\t\t\tself.custom.insertInitiated\u003dFalse\n\t\t\tself.parent.clearForm()\n\texcept:\n\t\tpass"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "config": {
                "struct": {
                  "initiate": "{this.custom.insertInitiated}",
                  "now": "{this.custom.now}",
                  "time": "{this.custom.insertInitiatedTime}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value[\u0027initiate\u0027]:\n\t\tif system.date.isAfter(system.date.addSeconds(system.date.now(), -10), value[\u0027time\u0027]):\n\t\t\treturn True\n\treturn False",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.settings}!\u003dnull \u0026\u0026\r\n{../TaskName.props.text}!\u003d\u0027\u0027\u0026\u0026\r\n{../TaskNote.props.text}!\u003d\u0027\u0027\u0026\u0026\r\n{../Contact.props.text}!\u003d\u0027\u0027\u0026\u0026\r\n!{this.custom.insertInitiated}"
              },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "struct": {
                  "error": "{this.meta.tooltip.enabled}",
                  "initated": "{this.custom.insertInitiated}",
                  "sec5": "{this.custom.sec5}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value[\u0027error\u0027]:\n\t\treturn \"red\"\n\tif value[\u0027sec5\u0027]:\n\t\treturn \"green\"\n\tif value[\u0027initated\u0027]:\n\t\treturn \"yellow\"\n\treturn \"\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "error": "{this.meta.tooltip.enabled}",
                  "initated": "{this.custom.insertInitiated}",
                  "sec5": "{this.custom.sec5}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value[\u0027error\u0027]:\n\t\treturn \"Task Insert Fail, Refresh and Try Again\"\n\tif value[\u0027sec5\u0027]:\n\t\treturn \"Task Created\"\n\tif value[\u0027initated\u0027]:\n\t\treturn \"Creating Task...\"\n\treturn \"Insert Task\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
