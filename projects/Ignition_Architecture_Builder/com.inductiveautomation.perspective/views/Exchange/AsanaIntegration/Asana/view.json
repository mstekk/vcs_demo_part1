                  "code": "\tinstances\u003d[]\n\tselected\u003d\u0027\u0027\n\tedit\u003dFalse\n\tfor x in value[\u0027data\u0027]:\n\t\tif \u0027selected\u0027 in x.keys():\n\t\t\tselected\u003dx[\u0027selected\u0027]\n\t\tif \u0027edit\u0027 in x.keys():\n\t\t\tedit \u003dx[\u0027edit\u0027]\n\t\tinstances.append({\"custom_field\":x[\u0027custom_field\u0027], \"selected\": selected, \u0027labelwidth\u0027: 150, \"edit\": edit, \"userEdit\": True})\n\treturn instances",
