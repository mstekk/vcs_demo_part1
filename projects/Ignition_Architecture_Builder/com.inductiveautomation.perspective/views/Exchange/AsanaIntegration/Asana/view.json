    "custom.workspace": {
      "binding": {
        "config": {
          "path": "view.params.token"
        },
        "transforms": [
          {
            "code": "\tif value\u003d\u003d\u0027\u0027 or value is None:\n\t\treturn {}\n\t# Parameters\n\tapi_token \u003d value\n\turl \u003d \"https://app.asana.com/api/1.0/workspaces\"\n\t\n\t# Headers\n\theaders\u003dself.getChild(\"root\").getAsanaHeader(api_token)\n\t\n\t# Convert data to JSON\n\timport json\n\t\n\t# Make the HTTP POST request\n\tresponse \u003d system.net.httpGet(url\u003d url, headerValues\u003dheaders)\n\t\n\t# Print the response\n\treturn json.loads(response)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.token": {
      "paramDirection": "input",
      "persistent": true
    }
