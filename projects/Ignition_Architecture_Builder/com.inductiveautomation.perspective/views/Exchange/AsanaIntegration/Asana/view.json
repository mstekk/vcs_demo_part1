  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tif \u0027Asana\u0027 in system.util.getGlobals().keys():\n\t\tself.getChild(\"root\").getChild(\"Workspaces\").props.value\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"workspace\"]\n\t\tself.getChild(\"root\").getChild(\"Teams\").props.value\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"team\"]\n\t\tself.getChild(\"root\").getChild(\"Projects\").props.value\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"project\"]\n\t\tself.getChild(\"root\").getChild(\"Sections\").props.value\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"section\"]\n\t\tself.getChild(\"root\").getChild(\"TextArea\").props.text\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"defaultNote\"]\n\t\tself.custom.savedCustomFields\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"custom_filters\"]\n\t\tself.getChild(\"root\").getChild(\"FlexRepeater\").props.instances\u003dsystem.util.getGlobals()[\u0027Asana\u0027][\"custom_filters\"]\n\telse:\n\t\tself.custom.savedCustomFields\u003dNone"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "token": ""
  },
  "propConfig": {
    "custom.customFields": {
      "binding": {
        "config": {
          "struct": {
            "project": "{/root/Projects.props.value}",
            "savedFields": "{view.custom.savedCustomFields}",
            "token": "{view.params.token}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value[\u0027savedFields\u0027]!\u003dNone:\n\t\treturn {\u0027data\u0027 : value[\u0027savedFields\u0027]}\n\telse:\n\t\t# Parameters\n\t\tapi_token \u003d value[\u0027token\u0027]\n\t\turl \u003d \"https://app.asana.com/api/1.0/projects/{}/custom_field_settings\".format(value[\u0027project\u0027])\n\t\t\n\t\t# Headers\n\t\theaders\u003dself.getChild(\"root\").getAsanaHeader(api_token)\n\t\t\n\t\t# Convert data to JSON\n\t\timport json\n\t\t\n\t\t# Make the HTTP POST request\n\t\tresponse \u003d system.net.httpGet(url\u003d url, headerValues\u003dheaders)\n\t\t\n\t\t# Print the response\n\t\treturn json.loads(response)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.projects": {
      "binding": {
        "config": {
          "struct": {
            "team": "{/root/Teams.props.value}",
            "token": "{view.params.token}",
            "workspace": "{/root/Workspaces.props.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t# Parameters\n\tapi_token \u003d value[\u0027token\u0027]\n\turl \u003d \"https://app.asana.com/api/1.0/projects?workspace\u003d{}\u0026team\u003d{}\".format(value[\u0027workspace\u0027],value[\u0027team\u0027])\n\t\n\t# Headers\n\theaders\u003dself.getChild(\"root\").getAsanaHeader(api_token)\n\t\n\t# Convert data to JSON\n\timport json\n\t\n\t# Make the HTTP POST request\n\tresponse \u003d system.net.httpGet(url\u003d url, headerValues\u003dheaders)\n\t\n\t# Print the response\n\treturn json.loads(response)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.savedCustomFields": {
      "persistent": true
    },
    "custom.sections": {
