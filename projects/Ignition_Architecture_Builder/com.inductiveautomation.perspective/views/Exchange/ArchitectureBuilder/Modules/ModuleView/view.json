{
  "custom": {},
  "params": {
    "delete": true,
    "desc": "value",
    "enabled": true,
    "image": "",
    "link": "www.inductiveautomation.com",
    "move": false,
    "moving": false,
    "name": "MQTT Engine",
    "selected": false
  },
  "propConfig": {
    "params.delete": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.desc": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.image": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.link": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.move": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.moving": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 63,
      "width": 199
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ModuleImage"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.params.image"
              },
              "transforms": [
                {
                  "code": "\tif value[:4] \u003d\u003d\"http\" or value[:4] \u003d\u003d\"data\":\n\t\treturn value.decode(\u0027unicode-escape\u0027)\n\telse:\n\t\treturn \u0027data:image/svg+xml;base64,{}\u0027.format(value.decode(\u0027unicode-escape\u0027))",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "struct": {
                  "enabled": "{view.params.enabled}",
                  "selected": "{view.params.selected}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value[\u0027enabled\u0027]:\n\t\tif value[\u0027selected\u0027]:\n\t\t\treturn \u0027#CCFFCC\u0027\n\t\telse:\n\t\t\treturn \u0027--neutral-10\u0027\n\telse:\n\t\treturn \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.filter": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": false,
                      "output": "grayscale(100%)"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "mode": "contain"
          },
          "style": {
            "borderBottomLeftRadius": "8px",
            "borderBottomRightRadius": "8px",
            "borderTopLeftRadius": "8px",
            "borderTopRightRadius": "8px",
            "cursor": "pointer",
            "max-width": "30px",
            "overflow": "visible",
            "padding": "4px"
          }
        },
        "type": "ia.display.image"
      },
      {
        "meta": {
          "name": "ModuleName"
        },
        "position": {
          "basis": "150px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.name"
              },
              "type": "property"
            }
          },
          "props.textStyle.color": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": false,
                      "output": "--neutral-60"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginLeft": "8px"
          },
          "textStyle": {
            "fontSize": 12,
            "fontWeight": "600",
            "whiteSpace": "pre-wrap",
            "wordWrap": "break-word"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "50px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "session.custom.showDescriptions"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.desc"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": 12,
            "fontStyle": "italic",
            "marginLeft": "8px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(\u0027removeModule\u0027, self.view.params.name)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "style": {
                "cursor": "pointer"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "24px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.delete} \u0026\u0026 {view.params.name}!\u003d\u0027Platform\u0027 \u0026\u0026 !{view.params.move}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "justify": "flex-end"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Checkbox"
            },
            "position": {
              "basis": "56px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.moving"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "padding": 0
              },
              "text": " ",
              "textPosition": "left"
            },
            "type": "ia.input.checkbox"
          }
        ],
        "meta": {
          "name": "FlexContainer_0"
        },
        "position": {
          "basis": "24px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.name}!\u003d\u0027Platform\u0027 \u0026\u0026 {view.params.move} \u0026\u0026 {view.params.name}!\u003d\u0027OPC UA\u0027"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "justify": "flex-end",
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tif self.view.params.enabled and not self.view.params.delete:\n\t\tself.view.params.selected\u003dnot self.view.params.selected"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "contextMenu": {
        "enabled": true,
        "items": [
          {
            "children": [],
            "icon": {
              "color": "",
              "path": "material/link",
              "style": {}
            },
            "link": {
              "target": "tab"
            },
            "message": {
              "payload": {},
              "scope": "page",
              "type": ""
            },
            "method": {
              "name": "",
              "params": {}
            },
            "style": {
              "classes": ""
            },
            "text": "Product Details",
            "type": "link"
          }
        ]
      },
      "name": "root"
    },
    "propConfig": {
      "meta.contextMenu.items[0].link.url": {
        "binding": {
          "config": {
            "path": "view.params.link"
          },
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "struct": {
              "enabled": "{view.params.enabled}",
              "selected": "{view.params.selected}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\tif value[\u0027enabled\u0027]:\n\t\tif value[\u0027selected\u0027]:\n\t\t\treturn \u0027--neutral-30\u0027\n\t\telse:\n\t\t\treturn \u0027--neutral-10\u0027\n\telse:\n\t\treturn \u0027\u0027",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "props": {
      "style": {
        "borderBottomLeftRadius": "8px",
        "borderBottomRightRadius": "8px",
        "borderTopLeftRadius": "8px",
        "borderTopRightRadius": "8px",
        "margin": "4px",
        "overflow": "visible",
        "padding": "6px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "removeModule",
          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027removeModule\u0027, self.view.params.name)\n\tif payload\u003d\u003dself.view.params.name:\n\t\tself.view.params.selected\u003dFalse",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}