{
  "custom": {
    "display": "New 2 by Kymera"
  },
  "params": {
    "currentModules": [],
    "input": {
      "author": "Kymera",
      "desc": "Retrieves data from SNMP V1, V2c and V3 agents making it available via OPC so that Ignition and other OPC-UA compliant systems can monitor network health and computer statistics.",
      "display": "New 2 by Kymera",
      "enabled": true,
      "id": "",
      "image": "https://docs.inductiveautomation.com/img/Logo-Ignition-Check.svg",
      "link": "https://www.kymerasystems.com/modules/",
      "name": "New 2",
      "price": "Contact Kymera",
      "selected": false
    },
    "mode": ""
  },
  "propConfig": {
    "custom.display": {
      "binding": {
        "config": {
          "expression": "{view.params.input.name}+ \" by \" +{view.params.input.author}"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\tif self.params.input!\u003dFalse:\n\t\tself.params.input.display\u003dcurrentValue.value"
      },
      "persistent": true
    },
    "params.currentModules": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.input": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.mode": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 380,
      "width": 484
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon",
              "tooltip": {
                "enabled": true
              }
            },
            "position": {
              "basis": "30px"
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "path": "view.params.mode"
                  },
                  "transforms": [
                    {
                      "code": "\tif value\u003d\u003d\u0027Ignore\u0027:\n\t\tmessage\u003d \u0027be Ignored\u0027\n\telif value\u003d\u003d\u0027Overwrite\u0027:\n\t\tmessage\u003d  \u0027overwrite current Module\u0027\n\t\t\n\treturn \u0027Conflict in Current Modules, this module (\"{}\") will {}\u0027.format(self.view.params.input.display, message)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "view.params.input.display"
                  },
                  "transforms": [
                    {
                      "code": "\treturn value in self.view.params.currentModules",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "color": "red",
              "path": "material/warning"
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "ModuleName"
            },
            "position": {
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.params.backColor": {
                "binding": {
                  "config": {
                    "path": "this.props.params.text"
                  },
                  "transforms": [
                    {
                      "code": "\tif value in [None, \u0027\u0027]:\n\t\treturn \"#FFCCCC\"\n\treturn \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
