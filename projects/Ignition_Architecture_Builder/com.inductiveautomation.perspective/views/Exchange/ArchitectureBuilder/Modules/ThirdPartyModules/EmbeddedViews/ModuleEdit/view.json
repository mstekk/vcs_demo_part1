              "path": "Exchange/ArchitectureBuilder/General/TextInput"
            },
            "type": "ia.display.view"
          },
          {
            "children": [
              {
                "events": {
                  "component": {
                    "onFileReceived": {
                      "config": {
                        "script": "\timport base64\n\tname\u003devent.file.name\n\t\n\text\u003dname.split(\".\")[-1]\n\t\n\tmime_types \u003d {\n\t    \u0027png\u0027: \u0027image/png\u0027,\n\t    \u0027jpg\u0027: \u0027image/jpeg\u0027,\n\t    \u0027jpeg\u0027: \u0027image/jpeg\u0027,\n\t    \u0027gif\u0027: \u0027image/gif\u0027,\n\t    \u0027svg\u0027: \u0027image/svg+xml\u0027,\n\t    # Add more mappings if necessary\n\t}\n\t# Function to convert file bytes to a base64-encoded string\n\tdef convert_file_to_base64(file_bytes, ext):\n\t\t# Open the image file in binary mode\n\t\tbase64_encoded_data \u003d base64.b64encode(file_bytes)\n\t\t# Convert bytes to string (Python 2.7)\n\t\tbase64_string \u003d base64_encoded_data.decode(\u0027utf-8\u0027)\n\t\tmime_type \u003d mime_types[ext.lower()]\n\t\tdata_url_prefix \u003d \u0027data:{};base64,\u0027.format(mime_type)\n\t\treturn data_url_prefix + base64_string\n\t\t\n\tsdata \u003d event.file.getBytes()\n\tbase64_image_string \u003d convert_file_to_base64(sdata, ext)\n\tself.parent.parent.getChild(\"Image\").props.params.text\u003dbase64_image_string"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "FileUpload"
                },
                "position": {
                  "basis": "400px"
                },
                "props": {
                  "supportedFileTypes": [
                    "svg",
                    "png",
                    "jpg"
                  ]
                },
                "type": "ia.input.fileupload"
              }
            ],
            "meta": {
              "name": "FlexContainer",
              "tooltip": {
                "enabled": true,
                "text": "SVG Upload"
              }
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "type": "ia.container.flex"
          }
