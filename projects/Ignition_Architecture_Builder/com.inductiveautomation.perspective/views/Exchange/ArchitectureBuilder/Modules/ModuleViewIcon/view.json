{
  "custom": {},
  "params": {
    "image": "",
    "name": "Alarm Notification"
  },
  "propConfig": {
    "params.image": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 48
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ModuleImage"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.params.image"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027data:image/svg+xml;base64,{}\u0027.format(value.decode(\u0027unicode-escape\u0027))",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "mode": "contain"
          },
          "style": {
            "borderBottomLeftRadius": "8px",
            "borderBottomRightRadius": "8px",
            "borderTopLeftRadius": "8px",
            "borderTopRightRadius": "8px"
          }
        },
        "type": "ia.display.image"
      }
    ],
    "meta": {
      "name": "root",
      "tooltip": {
        "enabled": true
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.name"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "flex-start",
      "style": {
        "borderBottomLeftRadius": "8px",
        "borderBottomRightRadius": "8px",
        "borderTopLeftRadius": "8px",
        "borderTopRightRadius": "8px",
        "padding": "2px"
      }
    },
    "type": "ia.container.flex"
  }
}