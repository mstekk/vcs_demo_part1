{
  "custom": {
    "key": {
      "Some Module": {
        "desc": "Configure and manage notifications systems and email notifications.",
        "image": "\\u003d\\u003d",
        "link": "https://inductiveautomation.com/ignition/modules/alarm-notification",
        "price": 2245
      }
    },
    "modules": null
  },
  "params": {
    "color": "--neutral-40",
    "preselected": [
      "Some Module"
    ],
    "providerName": "TEST",
    "selected": null,
    "text": null
  },
  "propConfig": {
    "custom.key": {
      "persistent": true
    },
    "custom.modules": {
      "binding": {
        "config": {
          "path": "view.params.providerName"
        },
        "transforms": [
          {
            "code": "\treturn exchange.architecturebuilder.modules.get(vendors\u003d[value])[value]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.preselected": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.providerName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "binding": {
        "config": {
          "path": "/root/FlexRepeater.props.instances"
        },
        "transforms": [
          {
            "code": "\tselected\u003d[]\n\tfor i in value:\n\t\tif i[\u0027selected\u0027]:\n\t\t\tselected.append(i[\u0027name\u0027])\n\treturn selected",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 162,
      "width": 701
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.text}\u003dnull, {view.params.providerName},{view.params.providerName})"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "marginRight": "8px"
                  },
                  "textStyle": {
                    "fontFamily": "Roboto",
                    "fontSize": 20,
                    "fontWeight": "bolder"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "Name"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "marginLeft": "8px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "display"
            },
            "position": {
              "basis": "30px"
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": ".../FlexRepeater.position.display"
                  },
                  "transforms": [
                    {
                      "fallback": "material/arrow_drop_down",
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "material/arrow_drop_up"
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "custom": {
          "display": false
        },
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tself.getSibling(\"FlexRepeater\").position.display\u003d not self.getSibling(\"FlexRepeater\").position.display"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "HEADER"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.color"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "justify": "space-between",
          "style": {
            "borderBottomLeftRadius": "8px",
            "borderBottomRightRadius": "8px",
            "borderTopLeftRadius": "8px",
            "borderTopRightRadius": "8px",
            "cursor": "pointer",
            "margin": "8px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "display": false,
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.modules"
              },
              "transforms": [
                {
                  "code": "\tinstances\u003d[]\n\tfor module in value.keys():\n\t\tselected\u003dFalse\n\t\tif module in self.view.params.preselected:\n\t\t\tselected\u003dTrue\n\t\tinstances.append({\n\t\t  \"link\": value[module][\u0027link\u0027],\n\t\t  \"image\": value[module][\u0027image\u0027].decode(\u0027unicode-escape\u0027),\n\t\t  \"selected\": selected,\n\t\t  \"name\": module\n\t\t})\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "flex-start",
          "direction": "column",
          "elementPosition": {
            "basis": "20px",
            "grow": 0,
            "shrink": 0
          },
          "loading": {
            "order": "with-parent"
          },
          "path": "Exchange/ArchitectureBuilder/Modules/ModuleView",
          "style": {
            "margin": "4px"
          },
          "wrap": "wrap"
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}