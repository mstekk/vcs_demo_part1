              "transforms": [
                {
                  "code": "\tdef markerCreate(uuid,lat,lng,index, color\u003d\"--callToAction\"):\n\t\tmarker\u003d{ \n\t\t  \"name\": uuid,\n\t\t  \"properties\": {},\n\t\t  \"enabled\": True,\n\t\t  \"lat\": lat,\n\t\t  \"lng\": lng,\n\t\t  \"opacity\": 1,\n\t\t  \"icon\": {\n\t\t    \"path\": \"material/location_city\",\n\t\t    \"color\": color,\n\t\t    \"rotate\": 0,\n\t\t    \"size\": {\"width\": 30,\"height\": 30},\n\t\t    \"style\": {\"classes\": \"\"}\n\t\t  },\n\t\t  \"event\": {\"stopPropagation\": False},\n\t\t  \"tooltip\": {\"content\": {\"text\": \"\",\"view\": {\"path\": \"\",\"params\": {}}},\n\t\t    \"direction\": \"auto\",\n\t\t    \"permanent\": False,\n\t\t    \"sticky\": False,\n\t\t    \"opacity\": 1\n\t\t  },\n\t\t  \"popup\": {\"enabled\": False,\"content\": {\"text\": \"\",\"view\": {\"path\": \"Exchange/ArchitectureBuilder/Map/embeddedViews/Site\",\"params\": {\"uuid\": uuid, \"index\": index}}},\n\t\t    \"width\": {\"max\": 400,\"min\": 0},\n\t\t    \"height\": {\"max\": None},\n\t\t    \"pan\": {\"auto\": True},\n\t\t    \"closeButton\": True,\n\t\t    \"autoClose\": True,\n\t\t    \"closeOnEscapeKey\": True,\n\t\t    \"closeOnClick\": None\n\t\t  }\n\t\t}\n\t\treturn marker\n\tcontainers\u003dvalue[\u0027containers\u0027]\n\tconfigs\u003dvalue[\u0027configs\u0027]\n\tmarkers\u003d[]\n\tnolocation\u003d[]\n\ti\u003d0\n\tfor container in containers:\n\t\tuuid\u003dcontainer.keys()[0]\n\t\tconfig\u003dconfigs[uuid][\u0027config\u0027]\n\t\tlat\u003dconfig[\u0027location\u0027][\u0027lat\u0027]\n\t\tlng\u003dconfig[\u0027location\u0027][\u0027lng\u0027]\n\t\tif \u0027location\u0027 in config.keys():\n\t\t\tif lat is not None and lng is not None:\n\t\t\t\tmarkers.append(markerCreate(uuid,lat,lng, i, config[\u0027backColor\u0027]))\n\t\t\telse:\n\t\t\t\tnolocation.append(uuid)\n\t\ti+\u003d1\n\tself.view.custom.noLocation\u003dnolocation\n\treturn markers",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
