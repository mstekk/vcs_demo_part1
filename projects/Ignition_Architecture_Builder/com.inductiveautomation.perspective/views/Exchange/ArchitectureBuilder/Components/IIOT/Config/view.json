        },
        "scripts": {
          "customMethods": [
            {
              "name": "deleteComponent",
              "params": [],
              "script": "\tuuid\u003dself.view.params.uuid\n\ttypeID\u003dself.view.custom.params.type\n\tsystem.perspective.sendMessage(\u0027selectFrame\u0027,{\u0027selected\u0027: True})\n\tsystem.perspective.sendMessage(\u0027deleteComponent\u0027, {\u0027uuid\u0027:uuid,\u0027type\u0027: typeID }, scope\u003d\"session\")"
            }
          ],
          "extensionFunctions": null,
          "messageHandlers": []
        },
        "type": "ia.input.oneshotbutton"
      }
    ],
    "meta": {
