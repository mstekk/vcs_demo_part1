                "marginLeft": "8px",
                "marginRight": "8px"
              },
              "text": "OK"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(self.view.params.uuid)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Cancel"
            },
            "position": {
              "basis": "33%",
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Exchange/ArchitectureBuilder/buttonHover",
                "marginLeft": "8px",
                "marginRight": "8px"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tfrom exchange.architecturebuilder.viewCanvas.auditEvents import insertAuditEvent\n\toriginatingSystem\u003d[\"source\",\"Layout\" ,\u0027uuid\u0027,self.view.params.uuid]\n\tinsertAuditEvent(self.session.custom.audit.layout, \"Component Configured\", self.view.custom.params.type, actionValue\u003dsystem.util.jsonEncode(self.view.custom.params.config), originatingSystem\u003doriginatingSystem)\n\tpayload\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.view.custom.params))\n\tsystem.perspective.sendMessage(\u0027updateViewParams\u0027, payload, scope\u003d\u0027session\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Apply"
            },
            "position": {
              "basis": "33%",
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Exchange/ArchitectureBuilder/buttonHover",
                "marginLeft": "8px",
                "marginRight": "8px"
              },
              "text": "Apply"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Apply"
        },
        "position": {
          "basis": "34px",
          "shrink": 0
        },
        "props": {
          "justify": "space-around",
