                  "code": "\tinstances\u003d[]\n\tfor x in value:\n\t\tinstances.append({\"connection\": value[x], \u0027uuid\u0027: x})\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
