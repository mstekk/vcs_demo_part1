  "propConfig": {
    "custom.connections": {
      "binding": {
        "config": {
          "struct": {
            "configs": "{session.custom.structure.configs}",
            "type": "{view.params.type}",
            "uuid": "{view.params.uuid}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tuuid\u003dvalue[\u0027uuid\u0027]\n\ttypes\u003dvalue[\u0027type\u0027]\n\tconfigs\u003dvalue[\u0027configs\u0027]\n\tcomponent\u003d{}\n\tif \u0027connections\u0027 in configs[uuid][\u0027config\u0027]:\n\t\tconnection\u003dconfigs[uuid][\u0027config\u0027][\u0027connections\u0027]\n\t\tfor c in connection:\n\t\t\tcomponents\u003dself.session.custom.connections[c].keys()\n\t\t\tc1\u003dsystem.util.jsonDecode(system.util.jsonEncode(configs[components[0]]))\n\t\t\tif c1[\u0027uuid\u0027]\u003d\u003duuid:\n\t\t\t\tc1[\u0027type\u0027]\u003dtypes\n\t\t\tc2\u003dsystem.util.jsonDecode(system.util.jsonEncode(configs[components[1]]))\n\t\t\tif c2[\u0027uuid\u0027]\u003d\u003duuid:\n\t\t\t\tc2[\u0027type\u0027]\u003dtypes\n\t\t\tcomponent[c]\u003d{components[0]: c1 , components[1]:c2}\n\n\treturn component",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.allow": {
      "binding": {
        "config": {
          "struct": {
            "configs": "{session.custom.structure.configs}",
            "connections": "{view.custom.connections}",
            "uuid": "{view.params.uuid}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tconnections\u003dvalue[\u0027connections\u0027]\n\talls\u003d[]\n\tfor connectionid in connections:\n\t\tconnection\u003dconnections[connectionid]\n\t\tconfigs\u003dvalue[\u0027configs\u0027]\n\t\tuuid\u003dvalue[\u0027uuid\u0027]\n\t\tnames\u003d[]\n\t\tgateways\u003d[\u0027standard\u0027, \u0027cloud\u0027, \u0027edge\u0027, \u0027panel\u0027]\n\t\tconnectionType\u003dconfigs[connectionid][\u0027config\u0027][\u0027connectionType\u0027]\n\t\tkeys\u003dconnection.keys()\n\t\tif connection[keys[0]][\u0027type\u0027] in gateways and connection[keys[1]][\u0027type\u0027] in gateways and connectionType\u003d\u003d\u0027Gateway Network\u0027:\n\t\t\toutgoing\u003dconfigs[connectionid][\u0027config\u0027][\u0027Outgoing\u0027]\n\t\t\tkey1\u003d{\u0027typeID\u0027: connection[keys[1]][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[keys[1]][\u0027type\u0027]), \u0027name\u0027: connection[keys[1]][\u0027name\u0027]}\n\t\t\tkey0\u003d{\u0027typeID\u0027: connection[keys[0]][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[keys[0]][\u0027type\u0027]), \u0027name\u0027: connection[keys[0]][\u0027name\u0027]}\n\t\t\tif keys[1]\u003d\u003doutgoing:\n\t\t\t\tnames.insert(0,key1)\n\t\t\telse:\n\t\t\t\tnames.append(key1)\n\t\t\tif keys[0]\u003d\u003doutgoing:\n\t\t\t\tnames.insert(0,key0)\n\t\t\telse:\n\t\t\t\tnames.append(key0)\n\t\telse:\n\t\t\tfor x in connection:\n\t\t\t\tcomptype\u003dconnection[x][\u0027type\u0027]\n\t\t\t\tif comptype in gateways:\n\t\t\t\t\tnames.insert(0,{\u0027typeID\u0027: connection[x][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[x][\u0027type\u0027]), \u0027name\u0027: connection[x][\u0027name\u0027]})\n\t\t\t\telse:\n\t\t\t\t\tnames.append({\u0027typeID\u0027: connection[x][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[x][\u0027type\u0027]), \u0027name\u0027: connection[x][\u0027name\u0027]})\n\t\talls.append(exchange.architecturebuilder.viewCanvas.connectionRules.connectionCheck([names[0][\u0027typeID\u0027],names[1][\u0027typeID\u0027]]))\n\tfor x in alls:\n\t\tif not x[\u0027allow\u0027]:\n\t\t\treturn False\n\treturn True",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.type": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.uuid": {
      "paramDirection": "input",
      "persistent": true
    }
  },
