{
  "custom": {
    "module": {
      "default": "Unlimited",
      "desc": "Easily build cutting-edge, modern industrial applications and freely deploy them to any web browser, mobile device, or desktop computer.",
      "id": "com.inductiveautomation.perspective",
      "image": "",
      "link": "https://inductiveautomation.com/ignition/modules/perspective",
      "name": "Perspective",
      "price": {
        "1 Session": 2775,
        "2 Sessions": 4370,
        "3 Sessions": 5965,
        "4 Sessions": 7560,
        "5 Sessions": 9155,
        "Unlimited": 11225
      },
      "selected": false
    }
  },
  "params": {
    "name": "Perspective",
    "selection": null,
    "vendor": "IA"
  },
  "propConfig": {
    "custom.module": {
      "binding": {
        "config": {
          "struct": {
            "module": "{view.params.name}",
            "vendor": "{view.params.vendor}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value[\u0027vendor\u0027] \u003d\u003d\u0027TPM\u0027:\n\t\tmodule\u003dsystem.tag.readBlocking([\u0027[default]Exchange/ArchitectureBuilder/TPM\u0027])[0].value[value[\u0027module\u0027]]\n\telse:\n\t\tmodule\u003dexchange.architecturebuilder.modules.getList(value[\u0027vendor\u0027], names\u003d[value[\u0027module\u0027]])[0]\n\t\n\treturn module",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selection": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.vendor": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 44,
      "width": 214
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "newTab": true,
                "url": "{view.custom.module.link}"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "name": "ModuleImage"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.custom.module.image"
              },
              "transforms": [
                {
                  "code": "\tif value[:4] \u003d\u003d\"http\" or value[:4] \u003d\u003d\"data\":\n\t\treturn value.decode(\u0027unicode-escape\u0027)\n\telse:\n\t\treturn \u0027data:image/svg+xml;base64,{}\u0027.format(value.decode(\u0027unicode-escape\u0027))",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "mode": "contain"
          },
          "style": {
            "classes": "iconHoverGrow",
            "cursor": "pointer",
            "filter": "drop-shadow(3px 3px 5px #00000080)",
            "key": "value",
            "max-width": "20px",
            "overflow": "visible"
          }
        },
        "type": "ia.display.image"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.vendor}\u003d\u0027TPM\u0027,{view.custom.module.display},{view.params.name})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "filter": "drop-shadow(3px 3px 4px #00000080)",
                "marginLeft": "4px",
                "whiteSpace": "pre-wrap"
              },
              "textStyle": {
                "fontSize": "12px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_0"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{view.params.selection}!\u003dnull"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\u0027(\u0027+{view.params.selection}+\u0027)\u0027"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "marginLeft": "16px"
              },
              "textStyle": {
                "color": "--neutral-80",
                "fontSize": "9px",
                "fontStyle": "italic",
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root",
      "tooltip": {
        "text": "EAM"
      }
    },
    "props": {
      "alignContent": "flex-start",
      "style": {
        "backgroundColor": "--neutral-30",
        "borderBottomLeftRadius": "8px",
        "borderBottomRightRadius": "8px",
        "borderTopLeftRadius": "8px",
        "borderTopRightRadius": "8px",
        "margin": "4px",
        "overflow": "visible",
        "padding": "4px"
      }
    },
    "type": "ia.container.flex"
  }
}