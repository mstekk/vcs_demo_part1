  "propConfig": {
    "custom.connection": {
      "binding": {
        "config": {
          "path": "view.custom.nameAndType"
        },
        "transforms": [
          {
            "code": "\treturn exchange.architecturebuilder.viewCanvas.connectionRules.connectionCheck([self.custom.nameAndType[0].typeID,self.custom.nameAndType[1].typeID])",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.nameAndType": {
      "binding": {
        "config": {
          "struct": {
            "configs": "{session.custom.structure.configs}",
            "connection": "{view.params.connection}",
            "uuid": "{view.params.uuid}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tconnection\u003dvalue[\u0027connection\u0027]\n\tconfigs\u003dvalue[\u0027configs\u0027]\n\tuuid\u003dvalue[\u0027uuid\u0027]\n\tnames\u003d[]\n\tgateways\u003d[\u0027standard\u0027, \u0027cloud\u0027, \u0027edge\u0027, \u0027panel\u0027]\n\tconnectionType\u003dconfigs[uuid][\u0027config\u0027][\u0027connectionType\u0027]\n\tkeys\u003dconnection.keys()\n\tif connection[keys[0]][\u0027type\u0027] in gateways and connection[keys[1]][\u0027type\u0027] in gateways and connectionType\u003d\u003d\u0027Gateway Network\u0027:\n\t\toutgoing\u003dconfigs[uuid][\u0027config\u0027][\u0027Outgoing\u0027]\n\t\tkey1\u003d{\u0027typeID\u0027: connection[keys[1]][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[keys[1]][\u0027type\u0027]), \u0027name\u0027: connection[keys[1]][\u0027name\u0027]}\n\t\tkey0\u003d{\u0027typeID\u0027: connection[keys[0]][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[keys[0]][\u0027type\u0027]), \u0027name\u0027: connection[keys[0]][\u0027name\u0027]}\n\t\tif keys[1]\u003d\u003doutgoing:\n\t\t\tnames.insert(0,key1)\n\t\telse:\n\t\t\tnames.append(key1)\n\t\tif keys[0]\u003d\u003doutgoing:\n\t\t\tnames.insert(0,key0)\n\t\telse:\n\t\t\tnames.append(key0)\n\telse:\n\t\tfor x in connection:\n\t\t\tcomptype\u003dconnection[x][\u0027type\u0027]\n\t\t\tif comptype in gateways:\n\t\t\t\tnames.insert(0,{\u0027typeID\u0027: connection[x][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[x][\u0027type\u0027]), \u0027name\u0027: connection[x][\u0027name\u0027]})\n\t\t\telse:\n\t\t\t\tnames.append({\u0027typeID\u0027: connection[x][\u0027type\u0027], \u0027type\u0027:exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(connection[x][\u0027type\u0027]), \u0027name\u0027: connection[x][\u0027name\u0027]})\n\treturn names",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.allowed": {
      "binding": {
        "config": {
