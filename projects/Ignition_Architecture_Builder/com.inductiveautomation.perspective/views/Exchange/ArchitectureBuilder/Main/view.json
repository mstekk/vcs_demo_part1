        {
          "messageType": "openPopup",
          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027openPopup\u0027, {\u0027uuid\u0027:self.view.params.uuid, \u0027path\u0027:\u0027Exchange/ArchitectureBuilder/Modules/ModuleSelection\u0027,\u0027params\u0027:{\u0027gatewayUUID\u0027:self.view.params.uuid, \u0027preselected\u0027:self.view.params.config.modules, \u0027name\u0027:name, \u0027gwType\u0027: gwType.lower()},title:\u0027Module Selection\u0027})\n\tpage\u003d\u0027\u0027\n\tif \u0027page\u0027 in payload:\n\t\tpage\u003dpayload[\u0027page\u0027]\n\t\n\t\n\tsystem.perspective.openPopup(payload[\u0027uuid\u0027], payload[\u0027path\u0027], params\u003dpayload[\u0027params\u0027], title\u003dpayload[\u0027title\u0027], pageId\u003dpage, viewportBound\u003dTrue, resizable\u003dFalse, modal\u003dTrue, position\u003d{\u0027width\u0027: \u0027auto\u0027})",
          "sessionScope": true,
          "viewScope": false
