    "params.archID": {
      "onChange": {
        "enabled": null,
        "script": "\timport time\n\tif not self.session.custom.public and self.session.custom.mongo.mongoArchs.collection not in [None, \u0027\u0027] and self.session.custom.mongo.mongoArchs.connector not in [None, \u0027\u0027]:\n\t\ttime.sleep(3)\n\t\tfrom exchange.architecturebuilder.viewCanvas.auditEvents import insertAuditEvent\n\t\tif currentValue.value is not None and currentValue.value is not \"\":\n\t\t\tconnector\u003dself.session.custom.mongo.mongoArchs.connector\n\t\t\tcollection\u003dself.session.custom.mongo.mongoArchs.collection\n\t\t\tload\u003dTrue\n\t\t\tdocId\u003dself.params.archID\n\t\t\tsystem.perspective.sendMessage(\u0027loadArchitecture\u0027, {\u0027connector\u0027:connector, \u0027collection\u0027:collection,\u0027id\u0027:docId, \u0027load\u0027:load}, scope\u003d\u0027session\u0027)\n\t\t\n\t\t\n\t\t"
      },
