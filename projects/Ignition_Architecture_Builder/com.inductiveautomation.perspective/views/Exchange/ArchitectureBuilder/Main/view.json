      "persistent": true
    },
    "params.meetingID": {
      "onChange": {
        "enabled": null,
        "script": "\tfrom system.mongodb.types import ObjectId\n\tfrom exchange.architecturebuilder.viewCanvas.auditEvents import insertAuditEvent\n\tlogger \u003d system.util.getLogger(\"saveMongo\")\n\t\n\tdef saveArchitecture(connector,collection,meetingId,filename):\n\t\t# Deep copy session data for saving\n\t\tcomponents\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.components))\n\t\tconnections\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.connections))\n\t\tcontainers\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.containers))\n\t\tconfig\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.structure.configs))\n\t\tcanvasSize\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.canvasSize))\n\t\tsaveDate\u003dsystem.date.now()\n\t\t\n\t\t# Construct dictionary of items to save\n\t\tsaveItems\u003d{\n\t\t\t\t\u0027filename\u0027:filename,\n\t\t\t\t\u0027meetingId\u0027:meetingId,\n\t\t\t\t\u0027saveDate\u0027:saveDate,\n\t\t\t\t\u0027components\u0027:components,\n\t\t\t\t\u0027connections\u0027:connections,\n\t\t\t\t\u0027containers\u0027:containers,\n\t\t\t\t\u0027config\u0027:config,\n\t\t\t\t\"canvasSize\":canvasSize}\n\t\t\t\t\n\t\t# Log saveItems dictionary\n\t\tlogger \u003d system.util.getLogger(\"saveMongo\")\n\t\tlogger.info(str(saveItems))\t\n\t\t\n\t\t# Determine whether to insert or update in MongoDB\n\t\tmongoid\u003dsystem.mongodb.insertOne(connector, collection, saveItems)\n\n\t\t\t\n\t\t# Update lastMongoLoadID in the view context\t\n\t\tlastSave\u003d{\u0027filename\u0027:filename, \u0027id\u0027:mongoid, \u0027saveDate\u0027:saveDate, \u0027connector\u0027:connector, \u0027collection\u0027:collection,\u0027meetingId\u0027:meetingId}\n\t\tself.view.custom.lastMongoLoadID\u003dlastSave\n\t\t# Send message \u0027lastSave\u0027 with details of the last save operation\n\t\tsystem.perspective.sendMessage(\u0027lastSave\u0027, lastSave, scope\u003d\u0027session\u0027)\n\t\treturn mongoid\n\t\t\n\t\t\n\tif currentValue.value is not None and currentValue.value is not \"\" and not self.session.custom.public and self.session.custom.mongo.mongoArchs.collection not in [None, \u0027\u0027] and self.session.custom.mongo.mongoArchs.connector not in [None, \u0027\u0027]:\n\n\t\tconnector\u003dself.session.custom.mongo.mongoArchs.connector\n\t\tcollection\u003dself.session.custom.mongo.mongoArchs.collection\n\t\t\n\t\tdefault\u003dexchange.architecturebuilder.viewCanvas.senotes.getDefaultTemplate()\n\t\tself.session.custom.canvasSize\u003ddefault[\"canvasSize\"]\n\t\tself.session.custom.components\u003ddefault[\"components\"]\n\t\tself.session.custom.connections\u003ddefault[\"connections\"]\n\t\tself.session.custom.containers\u003ddefault[\"containers\"]\n\t\tself.session.custom.structure.configs\u003ddefault[\"configs\"]\n\n\t\tmeetingId\u003dself.params.meetingID\n\t\tfilter \u003d {\"_id\":ObjectId(meetingId)}\n\t\tproject\u003d {\"accountName\":1, \"startDate\":1}\n\t\tdoc\u003dsystem.mongodb.findOne(self.session.custom.mongo.mongoNotes.connector, self.session.custom.mongo.mongoNotes.collection, filter, project)\n\t\taccount\u003ddoc[\u0027accountName\u0027]\n\t\tmeetingDate\u003ddoc[\u0027startDate\u0027]\n\n\t\tnowDate\u003dsystem.date.format(system.date.now(),\"dd-HHmmss\")\n\t\tfilename\u003d\u0027{}-{}-{}\u0027.format(account,system.date.format(meetingDate,\"MM/dd/yy-HH:mm\"),nowDate)\n\t\tlogger.info(filename)\n\t\tsaveArchitecture(connector,collection,meetingId,filename)\n\n\t\tsystem.perspective.navigate(\"/\")\n\t\t\n\n\t\t\n"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
