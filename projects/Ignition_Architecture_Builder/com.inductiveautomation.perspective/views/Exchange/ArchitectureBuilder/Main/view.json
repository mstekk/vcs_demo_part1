        "transforms": [
          {
            "code": "\tif value[\u0027trigger\u0027] and value[\u0027archID\u0027] is not None and not self.session.custom.public and self.session.custom.mongo.mongoArchs.collection not in [None, \u0027\u0027] and self.session.custom.mongo.mongoArchs.connector not in [None, \u0027\u0027]:\n\t\tconnector\u003dself.session.custom.mongo.mongoArchs.connector\n\t\tcollection\u003dself.session.custom.mongo.mongoArchs.collection\n\t\tload\u003dTrue\n\t\tdocId\u003dself.params.archID\n\t\tself.params.archID\u003dNone\n\t\tsystem.perspective.sendMessage(\u0027loadArchitecture\u0027, {\u0027connector\u0027:connector, \u0027collection\u0027:collection,\u0027id\u0027:docId, \u0027load\u0027:load}, scope\u003d\u0027session\u0027)\n\t\treturn True\n\treturn False",
