        {
          "messageType": "loadArchitecture",
          "pageScope": false,
          "script": "\t# implement your handler here\n\tif payload[\u0027load\u0027]:\n\t\tconnector\u003dpayload[\u0027connector\u0027]\n\t\tcollection\u003dpayload[\u0027collection\u0027]\n\t\tdocId\u003dpayload[\u0027id\u0027]\n\t\tfrom system.mongodb.types import ObjectId\n\t\tfilter \u003d {\"_id\":ObjectId(docId)}\n\t\tdoc\u003dsystem.mongodb.findOne(connector, collection, filter)\n\t\tif \u0027meetingId\u0027 in doc.keys():\n\t\t\tmeetingId\u003ddoc[\u0027meetingId\u0027]\n\t\telse:\n\t\t\tmeetingId\u003d\u0027\u0027\n\t\tif \u0027canvasSize\u0027 in doc.keys():\n\t\t\tcanvasSize\u003ddoc[\u0027canvasSize\u0027]\n\t\telse:\n\t\t\tcanvasSize\u003d{\u0027height\u0027:25000,\u0027width\u0027:25000}\n\t\tmongoLast\u003d{\u0027filename\u0027:doc[\u0027filename\u0027], \u0027id\u0027:doc[\u0027_id\u0027], \u0027saveDate\u0027:doc[\u0027saveDate\u0027],\t\u0027connector\u0027:connector, \u0027collection\u0027:collection, \u0027meetingId\u0027:meetingId,\u0027canvasSize\u0027:canvasSize}\n\t\tself.view.custom.lastMongoLoadID\u003dmongoLast\n\t\tsystem.perspective.sendMessage(\u0027updateLastMongo\u0027, mongoLast, scope\u003d\u0027page\u0027)",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "clearCenterComponents",
          "pageScope": true,
          "script": "\t# implement your handler here\n\tif not payload:\n\t\tmongoLast\u003d{}\n\t\tself.view.custom.lastMongoLoadID\u003dmongoLast\n\t\tsystem.perspective.sendMessage(\u0027updateLastMongo\u0027, mongoLast, scope\u003d\u0027page\u0027)\n\t\tself.view.params.archID\u003dNone\n\t\tself.view.params.meetingID\u003dNone",
          "sessionScope": true,
          "viewScope": false
        },
        {
          "messageType": "requestSave",
          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027requestSave\u0027, True, scope\u003d\u0027session\u0027)\n\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\tif self.session.custom.saveToMongo:\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/SaveArchitectureToMongo\u0027\n\telse:\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/SaveArchitectureToFileSystem\u0027\n\tsystem.perspective.openPopup(\u0027saveArchitecture\u0027, view, params\u003d{\u0027lastLoad\u0027: self.view.custom.lastMongoLoadID}, title\u003d\u0027Save Architecture\u0027)",
          "sessionScope": true,
