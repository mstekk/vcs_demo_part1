          },
          "transforms": [
            {
              "code": "\tif value\u003d\u003dNone or len(value.keys())\u003d\u003d0:\n\t\treturn False\n\telse:\n\t\treturn True",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "meta.contextMenu.items[0].children": {
        "binding": {
          "config": {
            "path": "view.custom.packages"
          },
          "transforms": [
            {
              "code": "\titems\u003d[]\n\tfor key in  value.keys():\n\t\titems.append({\n\t\t  \"text\": key.upper(),\n\t\t  \"icon\": {\n\t\t    \"path\": \"\",\n\t\t    \"color\": \"\",\n\t\t    \"style\": {}\n\t\t  },\n\t\t  \"style\": {\n\t\t    \"classes\": \"\"\n\t\t  },\n\t\t  \"type\": \"method\",\n\t\t  \"children\": [],\n\t\t  \"link\": {\n\t\t    \"url\": \"\",\n\t\t    \"target\": \"self\"\n\t\t  },\n\t\t  \"method\": {\n\t\t    \"name\": \"package\",\n\t\t    \"params\": {\n\t\t      \"package\": key\n\t\t    }\n\t\t  },\n\t\t  \"message\": {\n\t\t    \"type\": \"\",\n\t\t    \"payload\": {},\n\t\t    \"scope\": \"page\"\n\t\t  }\n\t\t})\n\treturn items\n",
              "type": "script"
            }
          ],
