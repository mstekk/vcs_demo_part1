          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027selectFrame\u0027, {\u0027params\u0027:self.view.params})\n\tif \u0027params\u0027 in payload.keys():\n\t\tif \u0027type\u0027 in payload[\u0027params\u0027].keys():\n\t\t\tif payload[\u0027params\u0027][\u0027type\u0027]\u003d\u003dself.view.params.params.type and payload[\u0027params\u0027][\u0027name\u0027]\u003d\u003dself.view.params.params.name:\n\t\t\t\tself.view.custom.selected\u003dnot self.view.custom.selected\n\t\t\telse:\n\t\t\t\tself.view.custom.selected\u003dFalse\n\telse:\n\t\tself.view.custom.selected\u003dFalse\n\t\t",
