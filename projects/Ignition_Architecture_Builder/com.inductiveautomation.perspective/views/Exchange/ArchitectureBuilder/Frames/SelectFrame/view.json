            "script": "\tif self.view.params.params.type\u003d\u003d\u0027Opto22\u0027:\n\t\tsystem.perspective.openPopup(\u0027InsertOpto\u0027, \"Exchange/ArchitectureBuilder/Components/Opto22/Popup\", title\u003d\"Select Opto22 Device\", modal\u003dTrue)\n\telif self.view.params.params.type\u003d\u003d\u0027fourIR\u0027:\n\t\tsystem.perspective.openPopup(\u0027Insert4IR\u0027, \"Exchange/ArchitectureBuilder/Components/4IR/Popup\", title\u003d\"Select 4IR Base Architecture\", modal\u003dTrue)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027panInteract\u0027, {\u0027action\u0027:\u0027Interact\u0027},scope\u003d\u0027page\u0027)\n\t\tif self.view.custom.selected:\n\t\t\tsystem.perspective.sendMessage(\u0027selectFrame\u0027, {\u0027selected\u0027:True}, scope\u003d\u0027session\u0027)\n\t\telse:\n\t\t\tsystem.perspective.sendMessage(\u0027selectFrame\u0027, self.view.params ,scope\u003d\u0027session\u0027)"
          },
