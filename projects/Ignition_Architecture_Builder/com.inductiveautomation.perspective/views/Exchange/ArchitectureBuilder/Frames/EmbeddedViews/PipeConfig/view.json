    },
    "custom.connectionProps": {
      "binding": {
        "config": {
          "expression": "property(\u0027session.custom.connections.\u0027+{view.params.uuid})"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.connections": {
      "binding": {
        "config": {
          "expression": "{view.custom.connectionProps}"
        },
        "transforms": [
          {
            "code": "\tconnections\u003d{}\n\tfor uuid in value:\n\t\tconnections[uuid]\u003dself.session.custom.structure.configs[uuid][\u0027type\u0027]\n\treturn connections",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": false
    },
    "custom.dir": {
      "binding": {
        "config": {
          "struct": {
            "components": "{session.custom.components}",
            "connections": "{view.custom.connectionProps}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tdef dire(lat,lng, meX, meY, oX, oY):\n\t\tif lat in [0,1] and lng in [0,1]:\n\t\t\tif abs(meX-oX)\u003eabs(meY-oY):\n\t\t\t\treturn \u0027vert\u0027\n\t\t\telse:\n\t\t\t\treturn \u0027horz\u0027\n\t\t\n\t\tif lat\u003d\u003d0 or lat\u003d\u003d1:\n\t\t\treturn \u0027horz\u0027\n\t\telif lng\u003d\u003d0 or lng\u003d\u003d1:\n\t\t\treturn \u0027vert\u0027\t\n\n\n#\tdef dire(lat,lng):\n#\t\tif lat\u003d\u003d0 or lat\u003d\u003d1:\n#\t\t\treturn \u0027horz\u0027\n#\t\tif lng\u003d\u003d0 or lng\u003d\u003d1:\n#\t\t\treturn \u0027vert\u0027\n\t\n\tcomponents\u003dvalue[\u0027components\u0027]\n\t\n\tcompUuids\u003dvalue[\u0027connections\u0027].keys()\n\tlat1\u003dvalue[\u0027connections\u0027][compUuids[0]][\u0027x\u0027]\n\tlng1\u003dvalue[\u0027connections\u0027][compUuids[0]][\u0027y\u0027]\n\tlat2\u003dvalue[\u0027connections\u0027][compUuids[1]][\u0027x\u0027]\n\tlng2\u003dvalue[\u0027connections\u0027][compUuids[1]][\u0027y\u0027]\n\tx1\u003dcomponents[compUuids[0]][\u0027left\u0027]+(lat1*components[compUuids[0]][\u0027width\u0027])\n\ty1\u003dcomponents[compUuids[0]][\u0027top\u0027]+((1-lng1)*components[compUuids[0]][\u0027height\u0027])\n\tx2\u003dcomponents[compUuids[1]][\u0027left\u0027]+(lat2*components[compUuids[1]][\u0027width\u0027])\n\ty2\u003dcomponents[compUuids[1]][\u0027top\u0027]+((1-lng2)*components[compUuids[1]][\u0027height\u0027])\n\texit1\u003ddire(lat1,lng1, x1,y1,x2,y2)\n\texit2\u003ddire(lat2,lng2, x2,y2,x1,y1)\n\treturn[exit1, exit2]",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.established": {
      "binding": {
        "config": {
          "struct": {
            "configs": "{session.custom.structure.configs}",
            "connection": "{view.custom.connection}",
            "connections": "{session.custom.connections}",
            "uuid": "{view.params.uuid}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tconnections\u003dvalue[\u0027connections\u0027]\n\tconnection\u003dconnections[value[\u0027uuid\u0027]].keys()\n\testablishedConnections\u003d[]\n\tif len(connection)\u003d\u003d2:\n\t\tuuid0\u003dconnection[0]\n\t\tuuid1\u003dconnection[1]\n\t\tfor x in connections:\n\t\t\tif x !\u003d value[\u0027uuid\u0027]:\n\t\t\t\tif uuid0 in connections[x].keys() and uuid1 in connections[x].keys():\n\t\t\t\t\testablishedConnections.append(value[\u0027configs\u0027][x][\u0027config\u0027][\u0027connectionType\u0027])\n\treturn establishedConnections\n\t\t\t\t",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.params": {
      "binding": {
