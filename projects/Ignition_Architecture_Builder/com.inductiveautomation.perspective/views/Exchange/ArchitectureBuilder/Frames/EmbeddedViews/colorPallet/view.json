{
  "custom": {},
  "params": {
    "color": "red",
    "type": "back"
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.type": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 32
    }
  },
  "root": {
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.sendMessage(\u0027colorPallet\u0027, {\u0027color\u0027: self.view.params.color, \u0027type\u0027: self.view.params.type})"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.color"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "cursor": "pointer",
        "margin": "1px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}