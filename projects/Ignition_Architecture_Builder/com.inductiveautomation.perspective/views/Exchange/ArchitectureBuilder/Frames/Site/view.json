{
  "custom": {},
  "params": {
    "config": {
      "backColor": "center  / contain no-repeat url(\"data:image/png;base64,\"),      #FFFFFF",
      "labelColor": "#000000",
      "location": {
        "lat": null,
        "lng": null
      },
      "quantity": 1,
      "transparency": 255,
      "vendor": false
    },
    "desc": "value",
    "name": "value",
    "type": "Container",
    "uuid": "value"
  },
  "propConfig": {
    "params.config": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.desc": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.type": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.uuid": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 244,
      "width": 208
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tuuid\u003dself.view.params.uuid\n\tpath\u003d\u0027Exchange/ArchitectureBuilder/Frames/EmbeddedViews/SiteConfig\u0027\n\tparams\u003d{\u0027uuid\u0027:uuid}\n\ttitle\u003d\u0027Container Configuration\u0027\n\tsystem.perspective.sendMessage(\u0027openPopup\u0027, {\u0027uuid\u0027:uuid, \u0027path\u0027:path,\u0027params\u0027:params,\u0027title\u0027:title},scope\u003d\u0027session\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "propConfig": {
              "props.color": {
                "binding": {
                  "config": {
                    "path": "view.params.config.labelColor"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "material/settings",
              "style": {
                "classes": "iconRotate",
                "cursor": "pointer",
                "overflow": "hidden"
              }
            },
            "scripts": {
              "customMethods": [
                {
                  "name": "align",
                  "params": [
                    "location"
                  ],
                  "script": "\tsystem.perspective.sendMessage(\u0027alignSite\u0027, {\u0027location\u0027:location, \u0027uuid\u0027:self.view.params.uuid})\n"
                },
                {
                  "name": "justify",
                  "params": [
                    "location"
                  ],
                  "script": "\tsystem.perspective.sendMessage(\u0027justifySite\u0027, {\u0027location\u0027:location, \u0027uuid\u0027:self.view.params.uuid})"
                },
                {
                  "name": "textEdit",
                  "params": [
                    "text",
                    "component"
                  ],
                  "script": "\tpath\u003d\u0027Exchange/ArchitectureBuilder/Frames/EmbeddedViews/TextEntry\u0027\n\tuuid\u003dself.view.params.uuid\n\tparams\u003d{\u0027text\u0027:text, \u0027component\u0027:component,\u0027uuid\u0027:self.view.params.uuid}\n\ttitle\u003d\u0027Area Text\u0027\n\tsystem.perspective.sendMessage(\u0027openPopup\u0027, {\u0027uuid\u0027:uuid, \u0027path\u0027:path,\u0027params\u0027:params,\u0027title\u0027:title},scope\u003d\u0027session\u0027)"
                },
                {
                  "name": "colorEdit",
                  "params": [
                    "color",
                    "component"
                  ],
                  "script": "\tpath\u003d\u0027Exchange/ArchitectureBuilder/Frames/EmbeddedViews/ColorSelector\u0027\n\tuuid\u003dself.view.params.uuid\n\tparams\u003d{\u0027color\u0027:color, \u0027component\u0027:component, \u0027uuid\u0027:self.view.params.uuid}\n\ttitle\u003d\u0027Color Selector\u0027\n\tsystem.perspective.sendMessage(\u0027openPopup\u0027, {\u0027uuid\u0027:uuid, \u0027path\u0027:path,\u0027params\u0027:params,\u0027title\u0027:title},scope\u003d\u0027session\u0027)"
                },
                {
                  "name": "configure",
                  "params": [],
                  "script": "\tpath\u003d\u0027Exchange/ArchitectureBuilder/Frames/EmbeddedViews/ContainerConfig\u0027\n\tparams\u003d{\u0027uuid\u0027:self.view.params.uuid, \u0027name\u0027:self.view.params.name, \u0027desc\u0027:self.view.params.desc, \u0027quantity\u0027:self.view.params.quantity}\n\ttitle\u003d\u0027Container Configuration\u0027\n\tuuid\u003dself.view.params.uuid\n\n\tsystem.perspective.sendMessage(\u0027openPopup\u0027, {\u0027uuid\u0027:uuid, \u0027path\u0027:path,\u0027params\u0027:params,\u0027title\u0027:title},scope\u003d\u0027session\u0027)"
                }
              ],
              "extensionFunctions": null,
              "messageHandlers": []
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "padding": "4px"
              },
              "textStyle": {
                "fontWeight": "bold",
                "vertical-align": "top"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Quantity"
            },
            "position": {
              "basis": "50px",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "view.params.config.quantity"
                  },
                  "transforms": [
                    {
                      "fallback": true,
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": 1,
                          "output": false
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.elements[0].text": {
                "binding": {
                  "config": {
                    "path": "view.params.config.quantity"
                  },
                  "transforms": [
                    {
                      "code": "\treturn \u0027x{}\u0027.format(value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "elements": [
                {
                  "name": "x",
                  "style": {
                    "classes": "",
                    "fill": "var(--neutral-10)",
                    "fontSize": 19,
                    "textAlign": "center"
                  },
                  "type": "text",
                  "x": 5,
                  "y": 18
                }
              ],
              "preserveAspectRatio": "xMinYMid",
              "style": {
                "cursor": "pointer"
              },
              "viewBox": "0 0 50 20"
            },
            "type": "ia.shapes.svg"
          },
          {
            "meta": {
              "name": "Vendor",
              "tooltip": {
                "enabled": true,
                "style": {
                  "whiteSpace": "pre"
                },
                "text": "Components contained in Vendor \narea are not calculated in the BOM"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.config.vendor"
                  },
                  "transforms": [
                    {
                      "code": "\tif value:\n\t\treturn value\n\treturn False",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.color": {
                "binding": {
                  "config": {
                    "path": "view.params.config.labelColor"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "material/lock",
              "style": {
                "classes": "",
                "cursor": "pointer",
                "overflow": "hidden"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.params.config.labelColor"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "style": {
            "filter": "drop-shadow(1px 1px 4px white)",
            "fontSize": 12,
            "overflow": "hidden",
            "width": "100%"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.background": {
        "binding": {
          "config": {
            "path": "view.params.config"
          },
          "transforms": [
            {
              "code": "\tif value[\u0027backColor\u0027][:2]\u003d\u003d\u0027--\u0027 or \u0027url\u0027 in str(value[\u0027backColor\u0027]):\n\t\treturn value[\u0027backColor\u0027]\n\tif \u0027transparency\u0027 not in value.keys():\n\t\treturn value[\u0027backColor\u0027]\n\talpha\u003d\u0027%02x\u0027 % value[\u0027transparency\u0027]\n\treturn value[\u0027backColor\u0027]+alpha",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "justify": "flex-end",
      "style": {
        "overflow": "visible",
        "padding": "4px"
      }
    },
    "type": "ia.container.flex"
  }
}