  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tlogger\u003dsystem.util.getLogger(\u0027admin\u0027)\n\tdef getConnectorState(name):\n\t\t\"\"\"\tRetrieves the state (allow, exists, index) of a connector with the given name.\n\t\tArgs:\n\t\t\tname (str): The name of the connector to retrieve state for.\n\t\t\tmongo_access (list): List of MongoDB connector objects.\n\t\tReturns:\n\t\t\tlist: A list containing [allow (bool), exists (bool), index (int)].\n\t\t\"\"\"\n\t\tallow\u003dTrue\n\t\texists\u003dFalse\n\t\tindex\u003d0\n\t\ti\u003d0\n\t\ttry:\n\t\t\tfor connector in self.session.custom.admin.mongoAccess:\n\t\t\t\tif name\u003d\u003dconnector[\u0027name\u0027]:\n\t\t\t\t\tallow \u003d collection[\u0027allow\u0027] if \u0027allow\u0027 in collection else True\n\t\t\t\t\texists\u003dTrue\n\t\t\t\t\tindex\u003di\n\t\t\t\t\tbreak\n\t\t\t\ti+\u003d1\n\t\texcept Exception as e:\n\t\t\tlogger.warn(\u0027{}\u0027.format(e))  # Log the error with trace level\n\t\t\tpass\n\t\treturn [allow,exists,index]\n\n\tdef getCollectionState(name,index):\n\t\t\"\"\"\tRetrieves the state (allow) of a collection with the given name from MongoDB.\n\t\tArgs:\n\t\t\tname (str): The name of the collection to retrieve state for.\n\t\t\tmongo_access (list): List of MongoDB connector objects.\n\t\tReturns:\n\t\t\tbool: True if the collection is allowed, False otherwise.\n\t\t\"\"\"\n\t\tallow\u003dTrue\n\t\ttry:\n\t\t\tfor collection in self.session.custom.admin.mongoAccess[index].collections:\n\t\t\t\tif name\u003d\u003dcollection[\u0027name\u0027]:\n\t\t\t\t\tallow \u003d collection[\u0027allow\u0027] if \u0027allow\u0027 in collection else True\n\t\t\t\t\tsystem.perspective.print(allow)\n\t\t\t\t\tbreak\n\t\texcept Exception as e:\n\t\t\tlogger.warn(\u0027{}\u0027.format(e))  # Log the error with trace level\n\t\treturn allow \n\t\n\tconnectors\u003dsystem.mongodb.listConnectorInfo()\n\tconnectorDrop\u003d[]\n\tfor connector in connectors:\n\t\tif connector[\u0027status\u0027]\u003d\u003d\u0027Valid\u0027 and connector[\u0027name\u0027] not in self.session.custom.admin.disabledMongoConnections:\n\t\t\tconnectorAllow\u003dgetConnectorState(connector[\u0027name\u0027])\n\t\t\texists\u003dconnectorAllow[1]\n\t\t\tindex\u003dconnectorAllow[2]\n\t\t\tcollections\u003dsystem.mongodb.listCollectionNames(connector[\u0027name\u0027])\n\t\t\tcollectionDrop\u003d[]\n\t\t\t\n\t\t\tfor collection in collections:\n\t\t\t\tcollectionAllow\u003dTrue\n\t\t\t\tif exists:\n\t\t\t\t\tcollectionAllow\u003dgetCollectionState(collection,index)\n\t\t\t\tcollectionDrop.append({\u0027name\u0027: collection, \u0027allow\u0027: collectionAllow})\n\t\t\t\n\t\t\tconnectorDrop.append({\n\t\t\t  \"name\": connector[\u0027name\u0027],\n\t\t\t  \"allow\": connectorAllow[0],\n\t\t\t  \"collections\": collectionDrop\n\t\t\t}) \n\tself.custom.connectors\u003dconnectorDrop\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
