{
  "custom": {},
  "params": {
    "allow": false,
    "collections": [
      {
        "allow": true,
        "name": "Architecture"
      },
      {
        "allow": true,
        "name": "Customer Architectures"
      }
    ],
    "name": "MongoNew"
  },
  "propConfig": {
    "params.allow": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.collections": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 164
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Checkbox"
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.allow"
                  },
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.name"
                  },
                  "transforms": [
                    {
                      "code": "\treturn \u0027Connection: {}\u0027.format(value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "checkedIcon": {
                "path": "material/visibility"
              },
              "uncheckedIcon": {
                "color": {
                  "enabled": "--neutral-100"
                },
                "path": "material/visibility_off"
              }
            },
            "type": "ia.input.checkbox"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "margin": "4px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "props": {
          "style": {
            "fontSize": "12px",
            "marginLeft": "12px"
          },
          "text": "Collection Visiblity:"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.collections"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "path": "Exchange/ArchitectureBuilder/Admin/Embedded/Collection",
          "style": {
            "marginLeft": "8px"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--neutral-30",
        "borderBottomLeftRadius": "16px",
        "borderBottomRightRadius": "16px",
        "borderTopLeftRadius": "16px",
        "borderTopRightRadius": "16px",
        "margin": "2px",
        "padding": "4px"
      }
    },
    "type": "ia.container.flex"
  }
}