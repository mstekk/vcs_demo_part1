{
  "custom": {},
  "params": {
    "description": "",
    "icon": "",
    "label": "",
    "size": 100
  },
  "propConfig": {
    "params.description": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.size": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 92
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "20px"
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.params.icon}!\u003d\u0027\u0027"
              },
              "type": "expr"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.icon"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginLeft": "16px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "expression": "{view.params.size}+\"px\""
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "transforms": [
                {
                  "code": "\treturn \u0027{} :\u0027.format(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginRight": "16px"
          },
          "textStyle": {
            "fontSize": 12,
            "fontStyle": "italic",
            "fontWeight": "bolder",
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.description"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "height": "40px",
            "marginRight": "16px"
          },
          "textStyle": {
            "fontSize": 13,
            "fontStyle": "italic"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "backgroundColor": "--neutral-30",
        "borderBottomLeftRadius": "16px",
        "borderBottomRightRadius": "16px",
        "borderTopLeftRadius": "16px",
        "borderTopRightRadius": "16px"
      }
    },
    "type": "ia.container.flex"
  }
}