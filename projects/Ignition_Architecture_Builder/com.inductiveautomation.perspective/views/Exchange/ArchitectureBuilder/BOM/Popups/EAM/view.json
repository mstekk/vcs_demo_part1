            "props": {
              "primary": false,
              "style": {
                "backgroundColor": "--neutral-50",
                "margin": "8px",
                "marginTop": "8px",
                "overflow": "auto"
              },
              "text": "Apply"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "shrink": 0
        },
        "scripts": {
