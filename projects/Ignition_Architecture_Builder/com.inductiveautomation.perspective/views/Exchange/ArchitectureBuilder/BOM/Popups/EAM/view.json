              "script": "\tself.session.custom.eamUnlimited.selected \u003d self.parent.getChild(\"Settings\").getChild(\"Unlimited\").props.selected\n\tself.session.custom.eamUnlimited.UUID \u003d self.parent.getChild(\"Settings\").getChild(\"FlexContainer\").getChild(\"Dropdown\").props.value\n\n\tif close:\n\t\tsystem.perspective.closePopup(\"EamUnlimited\")"
            }
          ],
          "extensionFunctions": null,
          "messageHandlers": []
