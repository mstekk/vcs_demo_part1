    "params.uuid": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 608
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ModuleImage"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.custom.device.image"
              },
              "transforms": [
                {
                  "code": "\t#return \u0027data:image/png;base64,{}\u0027.format(value.decode(\u0027unicode-escape\u0027))\n\treturn \u0027{}\u0027.format(value.decode(\u0027unicode-escape\u0027))",
