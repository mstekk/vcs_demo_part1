                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "mode": "contain"
          },
          "style": {
            "borderBottomLeftRadius": "8px",
            "borderBottomRightRadius": "8px",
            "borderTopLeftRadius": "8px",
            "borderTopRightRadius": "8px",
            "marginLeft": "4px",
            "marginRight": "4px",
            "paddingLeft": "2px",
            "paddingRight": 2
          }
        },
        "type": "ia.display.image"
      },
      {
        "meta": {
          "name": "TextField"
        },
        "position": {
          "basis": "150px"
        },
        "propConfig": {
          "props.text": {
