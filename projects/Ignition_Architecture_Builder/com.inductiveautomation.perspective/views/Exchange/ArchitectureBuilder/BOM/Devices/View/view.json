              "Modbus TCP",
              "Omron FINS/TCP",
              "Omron FINS/UDP",
              "Omron NJ Driver",
              "Siemens S7-1200",
              "Siemens S7-1500",
              "Siemens S7-300",
              "Siemens S7-400",
              "TCP Driver",
