              "config": {
                "bidirectional": true,
                "path": "view.custom.device.name"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "placeholder": "Device Name"
        },
        "type": "ia.input.text-field"
      },
      {
        "meta": {
          "name": "EmbeddedView"
        },
        "position": {
          "basis": "330px",
          "shrink": 0
