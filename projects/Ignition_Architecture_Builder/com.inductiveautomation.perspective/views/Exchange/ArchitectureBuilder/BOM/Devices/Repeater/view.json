            "value": 885
          }
        ],
        "showDesc": false
      },
      {
        "desc": "Monitor, commission, and deploy systems from one central gateway.",
        "image": "\\u003d",
        "name": "EAM",
        "price": [
          {
            "label": "1 Gateway",
            "value": 1595
          },
          {
            "label": "Unlimited",
            "value": 22330
          }
        ],
        "showDesc": false
      },
      {
        "desc": "Configure and manage notifications systems and email notifications.",
        "image": "\\u003d\\u003d",
        "name": "Alarm Notification",
        "price": 2245,
        "showDesc": false
      }
    ],
    "sample": {
      "price": [
        {
          "key": "value"
        },
        2349
      ]
    }
  },
  "params": {
    "rowData": "value",
    "showDesc": false,
    "value": {
      "gwConfig": {
        "modules": [
          {
            "image": "\u003d\u003d",
            "name": "Alarm Notification",
            "selected": true
          },
          {
            "image": "\u003d",
            "name": "EAM",
            "selected": true
          },
          {
            "image": "",
            "name": "OPC COM",
            "selected": true
          }
        ]
      },
      "type": "Standard"
    }
  },
  "propConfig": {
    "custom.allModules": {
      "binding": {
        "config": {
          "path": "view.params.value.gwConfig.modules"
        },
        "transforms": [
          {
            "code": "\t#\tdef is_key_value_pair_in_list(key, value, list_of_dicts):\n\t#\t\tfor d in list_of_dicts:\n\t#\t\t\tif key in d and d[key] \u003d\u003d value:\n\t#\t\t\t\treturn True\n\t#\t\treturn False\n\t#\tincludedModules\u003dsystem.util.jsonDecode(system.util.jsonEncode(value[\u0027includedModules\u0027]))\n\t#\tselectedModules\u003dsystem.util.jsonDecode(system.util.jsonEncode(value[\u0027selectedModules\u0027]))\n\t#\tfor selModule in selectedModules:\n\t#\t\tselModule[\u0027price\u0027]\u003d0\n\t#\n\t#\taddedModules\u003d[]\n\t#\tfor module in includedModules:\n\t#\t\tif not is_key_value_pair_in_list(\u0027name\u0027, module[\u0027name\u0027], selectedModules): \n\t#\t\t\tmodule[\u0027included\u0027]\u003dTrue\n\t#\t\t\tmodule[\u0027price\u0027]\u003d0\n\t#\t\t\taddedModules.append(module)#system.util.jsonDecode(system.util.jsonEncode(module)))\n\t#\treturn selectedModules+addedModules\n\tnames \u003d []\n\tfor module in value:\n\t\tnames.append(module[\u0027name\u0027])\n\tmodules \u003d exchange.architecturebuilder.modules.IA.getList(names)\n\t\n\tfor m in modules:\n\t\tm[\u0027showDesc\u0027] \u003d self.params.showDesc\n\treturn modules",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.sample": {
      "persistent": true
    },
    "params.rowData": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showDesc": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize.height": {
      "binding": {
        "config": {
          "expression": "44*len({view.custom.allModules}) + 4"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 752
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "len({view.custom.allModules})\u003e0"
              },
              "type": "expr"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.allModules"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
          "elementStyle": {
            "margin": "2px"
          },
          "path": "Exchange/ArchitectureBuilder/BOM/Modules/View",
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "expression": "len({view.custom.allModules})\u003e0"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--neutral-40",
        "borderBottomLeftRadius": "8px",
        "borderBottomRightRadius": "8px",
        "borderTopLeftRadius": "8px",
        "borderTopRightRadius": "8px",
        "margin": "8px",
        "marginBottom": "4px",
        "marginTop": "0px"
      }
    },
    "type": "ia.container.flex"
  }
}