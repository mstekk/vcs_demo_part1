{
  "custom": {},
  "params": {
    "value": {
      "enabled": false,
      "selected": false
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 150
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "view.params.value.enabled"
              },
              "transforms": [
                {
                  "fallback": "",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": false,
                      "output": "--neutral-50"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.value.selected"
              },
              "transforms": [
                {
                  "fallback": "material/radio_button_unchecked",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "material/radio_button_checked"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.style.cursor": {
            "binding": {
              "config": {
                "path": "view.params.value.enabled"
              },
              "transforms": [
                {
                  "fallback": "pointer",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": false,
                      "output": "not-allowed"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "justify": "center"
    },
    "type": "ia.container.flex"
  }
}