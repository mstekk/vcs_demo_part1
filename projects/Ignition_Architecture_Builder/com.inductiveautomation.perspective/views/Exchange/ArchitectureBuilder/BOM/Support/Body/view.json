{
  "custom": {
    "retail": 0,
    "supportPlan": "Total",
    "textFormat": {}
  },
  "params": {
    "type": "Standard",
    "uuid": "I06ac5707"
  },
  "propConfig": {
    "custom.plans": {
      "binding": {
        "config": {
          "expression": "runScript(\"exchange.architecturebuilder.modules.getSupportPlans()\")"
        },
        "transforms": [
          {
            "code": "\treturn sorted(value.items(), key \u003d lambda x: x[1][\"multiplier\"], reverse\u003dTrue)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.retail": {
      "binding": {
        "config": {
          "struct": {
            "eamUnlimited": "{session.custom.eamUnlimited}",
            "instance": "property(\"session.custom.structure.configs.\" + {view.params.uuid})",
            "type": "{view.params.type}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\ttotal \u003d 0\n\tif value[\u0027type\u0027] \u003d\u003d \u0027Cloud\u0027:\n\t\treturn total\n\telse:\n\t\tfor vendor in (\"IA\", \"CL\"):\n\t\t\tif value[\u0027instance\u0027] is not None:\n\t\t\t\tif vendor in value[\u0027instance\u0027][\u0027config\u0027][\u0027modules\u0027]:\n\t\t\t\t\t# Build list of selected modules\n\t\t\t\t\tselectedModules \u003d []\n\t\t\t\t\tmoduleVendors \u003d value[\u0027instance\u0027][\u0027config\u0027][\u0027modules\u0027][vendor]\n\t\t\t\t\t# Include EAM Unlimited if UUID matches\n\t\t\t\t\tif vendor \u003d\u003d \"IA\" and value[\"eamUnlimited\"][\"selected\"] and value[\"eamUnlimited\"][\"UUID\"] \u003d\u003d self.view.params.uuid:\n\t\t\t\t\t\tselectedModules.append({\"name\": \"EAM\", \"selection\": \"unlimited\"})\n\t\t\t\t\tfor m in moduleVendors:\n\t\t\t\t\t\tif \"selection\" in m.keys() and m[\"selection\"] is not None:\n\t\t\t\t\t\t\tselectedModules.append({\"name\": m[\"name\"], \"selection\": m[\"selection\"]})\n\t\t\t\t\t\telse:\n\t\t\t\t\t\t\tselectedModules.append(m[\"name\"])\n\t\t\t\t\ttotal +\u003d exchange.architecturebuilder.modules.getRetailTotal({vendor: selectedModules}, gwType\u003dvalue[\u0027type\u0027])[\u0027total\u0027]\n\t\treturn total",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.supportPlan": {
      "binding": {
        "config": {
          "expression": "coalesce(property(\"session.custom.structure.configs.\" + {view.params.uuid} + \".config.supportPlan\"), \u0027Total\u0027)"
        },
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.quality.isGood() and origin \u003d\u003d \"Script\":\n\t\tself.session.custom.structure.configs[self.params.uuid][\"config\"][\"supportPlan\"] \u003d currentValue.value"
      },
      "persistent": true
    },
    "custom.textFormat": {
      "persistent": true
    },
    "custom.textFormat.color": {
      "binding": {
        "config": {
          "expression": "if({view.params.type} \u003d \u0027Cloud\u0027,\r\n\t\"--neutral-50\",\r\n\t\"\")"
        },
        "type": "expr"
      }
    },
    "custom.textFormat.textDecoration": {
      "binding": {
        "config": {
          "expression": "if({view.params.type} \u003d \u0027Cloud\u0027,\r\n\t\"line-through\",\r\n\t\"\")"
        },
        "type": "expr"
      }
    },
    "params.type": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.uuid": {
      "paramDirection": "input",
      "persistent": true
    }
  },
