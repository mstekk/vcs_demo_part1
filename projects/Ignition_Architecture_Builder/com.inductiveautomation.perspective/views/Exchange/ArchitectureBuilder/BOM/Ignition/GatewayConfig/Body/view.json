            "code": "\treturn {\u0027development\u0027: value[\u0027development\u0027] if \u0027development\u0027 in value.keys() else False,\n\t\t\t\u0027redundant\u0027: value[\u0027redundant\u0027] if \u0027redundant\u0027 in value.keys() else False,\n\t\t\t\u0027trial\u0027: value[\u0027trial\u0027] if \u0027trial\u0027 in value.keys() else False,\n\t\t\t\u0027version\u0027: value[\u0027version\u0027] if \u0027version\u0027 in value.keys() else \u0027\u0027,\n\t\t\t\u0027licenseKey\u0027: value[\u0027licenseKey\u0027] if \u0027licenseKey\u0027 in value.keys() else \u0027\u0027,\n\t\t\t\u0027licenseKeyRedun\u0027: value[\u0027licenseKeyRedun\u0027] if \u0027licenseKeyRedun\u0027 in value.keys() else \u0027\u0027}",
