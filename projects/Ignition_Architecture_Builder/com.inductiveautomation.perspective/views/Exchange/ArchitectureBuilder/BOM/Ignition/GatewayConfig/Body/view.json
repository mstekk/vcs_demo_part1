        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\tif origin \u003d\u003d \u0027BindingWriteback\u0027:\n\t\tfor prop in currentValue.value.keys():\n\t\t\tself.session.custom.structure.configs[self.params.uuid][\u0027config\u0027][prop] \u003d currentValue.value[prop]"
