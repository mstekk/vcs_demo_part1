                  "config": {
                    "struct": {
                      "config": "property(\"session.custom.structure.configs.\" + {view.params.uuid})",
                      "discount": "{session.custom.discount}",
                      "eamUnlimited": "{session.custom.eamUnlimited}",
                      "supportCosts": "{view.params.supportCosts}",
                      "type": "{view.params.type}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\tif self.view.params.type \u003d\u003d \u0027Cloud\u0027:\n\t\treturnVal \u003d {\u0027msg\u0027: \u0027Check Provider\u0027, \u0027total\u0027: 0, \u0027retailTotal\u0027: 0, \u0027eamCost\u0027: 0, \u0027licenseDiscounted\u0027: 0, \u0027supportDiscounted\u0027: 0}\n\telif self.view.custom.trial:\n\t\treturnVal \u003d {\u0027total\u0027: 0, \u0027licenseDiscounted\u0027: 0, \u0027supportDiscounted\u0027: 0}\n\telse:\n\t\treturnVal \u003d {\u0027eamCost\u0027: 0}\n\t\teamCost \u003d 0\n\t\t# Build list of selected modules\n\t\tselections \u003d {}\n\t\tfor vendor in value[\u0027config\u0027][\u0027config\u0027][\u0027modules\u0027]:\n\t\t\tselectedModules \u003d []\n\t\t\tif len(value[\u0027config\u0027][\u0027config\u0027][\u0027modules\u0027][vendor]) \u003e 0:\n\t\t\t\tfor m in value[\u0027config\u0027][\u0027config\u0027][\u0027modules\u0027][vendor]:\n\t\t\t\t\tif \"selection\" in m.keys() and m[\"selection\"] is not None:\n\t\t\t\t\t\tselectedModules.append({\"name\": m[\"name\"], \"selection\": m[\"selection\"]})\n\t\t\t\t\telse:\n\t\t\t\t\t\tselectedModules.append(m[\"name\"])\n\t\t\t\tselections[vendor] \u003d selectedModules\n\t\t\t# Handle EAM Unlimited\n\t\t\tif vendor \u003d\u003d \"IA\" and value[\"eamUnlimited\"][\"selected\"]:\n\t\t\t\tif len(filter(lambda module: module \u003d\u003d \"EAM\", selections[\"IA\"])) \u003e 0:\n\t\t\t\t\tfor module in selections[\"IA\"]:\n\t\t\t\t\t\tif module \u003d\u003d \"EAM\":\n\t\t\t\t\t\t\tselections[\"IA\"].remove(module)\n\t\t\t\t\t\t\tbreak\n\t\t\t\tif value[\"eamUnlimited\"][\"UUID\"] \u003d\u003d self.view.params.uuid:\n\t\t\t\t\tselectedModules.append({\"name\": \"EAM\", \"selection\": \"unlimited\"})\n\t\t\t\t\treturnVal[\u0027eamCost\u0027] \u003d exchange.architecturebuilder.modules.getEamUnlimited()\n\n\t\treturnVal[\u0027licenseBase\u0027] \u003d exchange.architecturebuilder.modules.getRetailTotal(selections, gwType\u003dvalue[\u0027type\u0027])[\u0027total\u0027]\n\t\treturnVal[\u0027supportBase\u0027] \u003d exchange.architecturebuilder.modules.getSupportTotal(selections, supportPlan\u003dvalue[\u0027config\u0027][\u0027config\u0027][\u0027supportPlan\u0027], gwType\u003dvalue[\u0027type\u0027])[\u0027total\u0027]\n\n\t\t# Calculate total with discounts and redundancy\n\t\tlicense \u003d returnVal[\u0027licenseBase\u0027]\n\t\tsupport \u003d returnVal[\u0027supportBase\u0027]\n\t\tif value[\u0027config\u0027][\u0027config\u0027][\u0027redundant\u0027]:\n\t\t\tlicense \u003d license * 1.5\n\t\t\tsupport \u003d support * 1.5\n\t\tif value[\u0027config\u0027][\u0027config\u0027][\u0027development\u0027]:\n\t\t\tlicense \u003d license * 0.5\n\t\t\tsupport \u003d support * 0.5\n\t\treturnVal[\u0027licenseRetail\u0027] \u003d license\n\t\treturnVal[\u0027supportRetail\u0027] \u003d support\n\t\treturnVal[\u0027retailTotal\u0027] \u003d license + support\n\t\treturnVal[\u0027licenseDiscounted\u0027] \u003d (license * (1 - (value[\u0027discount\u0027] / 100.0)))\n\t\treturnVal[\u0027supportDiscounted\u0027] \u003d support * 0.9 if value[\u0027discount\u0027] \u003e 0 else support\n\t\treturnVal[\u0027total\u0027] \u003d returnVal[\u0027licenseDiscounted\u0027] + (returnVal[\u0027supportDiscounted\u0027] if value[\"supportCosts\"] else 0)\n\treturn returnVal",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              },
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.type} \u003d \u0027Cloud\u0027,\r\n\t\"License cost dependent on Cloud Provider, Region, and Instance Type. Total Care Support included.\",\r\n\t\"License: \" + numberFormat({this.custom.price.licenseDiscounted}, \"$#,##0.00\") + \"; Support: \" + \r\n\tif({view.params.supportCosts},\r\n\t\tnumberFormat({this.custom.price.supportDiscounted}, \"$#,##0.00\"),\r\n\t\t\"Not calculated\"))"
