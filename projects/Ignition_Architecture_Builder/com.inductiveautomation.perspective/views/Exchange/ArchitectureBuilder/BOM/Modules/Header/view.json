              "messageType": "priceRefresh",
              "pageScope": true,
              "script": "\tlogger \u003d system.util.getLogger(\"BOM/Headers/ModuleVendor\")\n\n\tif payload[\u0027uuid\u0027] \u003d\u003d self.view.params.UUID:\n\t\tif payload[\u0027vendor\u0027] in (\u0027Standard\u0027, \u0027Edge\u0027, \u0027Cloud\u0027):\n\t\t\tpayloadVendor \u003d \u0027IA\u0027\n\t\telse:\n\t\t\tpayloadVendor \u003d payload[\u0027vendor\u0027]\n\n\t\tlogger.info(\"payload[\u0027vendor\u0027] \u003d \" + payloadVendor)\n\t\tif payloadVendor \u003d\u003d self.view.params.vendor: \n\t\t\tself.refreshBinding(\"custom.price\")",
              "sessionScope": false,
              "viewScope": false
            }
          ]
