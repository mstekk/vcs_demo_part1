        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t# Determine new value\n\tisExpanded \u003d not self.view.params.expanded\n\n\tif self.session.custom.audit.bom:\n\t\t# Log Ignition Modules section expanded or collapsed\n\t\tif isExpanded:\n\t\t\taction \u003d \"Expanded\"\n\t\telse:\n\t\t\taction \u003d \"Collapsed\"\n\t\tsystem.util.audit(action\u003daction, actionTarget\u003d\"BOM\", actionValue\u003d\"Ignition Modules\", originatingSystem\u003d[\"uuid\",self.view.params.UUID,\"vendor\",self.view.params.vendor])\n\n\t# Send message (Exchange/ArchitectureBuilder/BOM/BillOfMaterials \u0026 Exchange/ArchitectureBuilder/BOM/Ignition/Body have handler)\n\tpayload \u003d {\u0027source\u0027: self.view.params.vendor, \u0027uuid\u0027: self.view.params.UUID, \u0027value\u0027: isExpanded}\n\tsystem.perspective.sendMessage(\"toggleExpansion\", payload)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Toggle",
          "tooltip": {
            "enabled": true,
            "text": "Expand/Collapse"
          }
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.expanded"
              },
              "transforms": [
