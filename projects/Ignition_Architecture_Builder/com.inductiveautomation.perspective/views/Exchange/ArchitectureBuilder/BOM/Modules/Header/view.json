      {
        "meta": {
          "name": "price",
          "tooltip": {}
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "custom.price": {
            "binding": {
              "config": {
                "struct": {
                  "config": "{session.custom.structure.configs}",
                  "discount": "{session.custom.discount}",
                  "eamUnlimited": "{session.custom.eamUnlimited}",
                  "instance": "property(\"session.custom.structure.configs.\" + {view.params.UUID})",
                  "type": "{view.params.type}",
                  "vendor": "{view.params.vendor}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tlogger \u003d system.util.getLogger(\"BOM/Headers/ModuleVendor\")\n\tlogger.info(\"Evaulating price.custom.retailTotal\")\n\n\tif value[\u0027type\u0027] \u003d\u003d \u0027Cloud\u0027:\n\t\treturn {\u0027msg\u0027:\u0027See Provider\u0027, \u0027total\u0027:0}\n\tif value[\u0027vendor\u0027] in value[\u0027instance\u0027][\u0027config\u0027][\u0027modules\u0027]:\n\t\t# Build list of selected modules\n\t\tselectedModules \u003d []\n\t\tmoduleVendors \u003d value[\u0027instance\u0027][\u0027config\u0027][\u0027modules\u0027][value[\u0027vendor\u0027]]\n\t\tfor m in moduleVendors:\n\t\t\tif \"selection\" in m.keys() and m[\"selection\"] not in (None, \"\"):\n\t\t\t\tselectedModules.append({\"name\": m[\"name\"], \"selection\": m[\"selection\"]})\n\t\t\telse:\n\t\t\t\tselectedModules.append(m[\"name\"])\n\t\tlogger.info(\"Calling \u0027getRetailTotal\u0027 for modules: \" + str(selectedModules))\n\n\t\tcost \u003d exchange.architecturebuilder.modules.getRetailTotal({value[\u0027vendor\u0027]: selectedModules}, gwType\u003dvalue[\u0027type\u0027])\n\n\t\tif value[\"eamUnlimited\"][\"selected\"] and value[\"vendor\"] \u003d\u003d \"IA\":\n\t\t\tif len(filter(lambda module: module \u003d\u003d \"EAM\", selectedModules)) \u003e 0:\n\t\t\t\tfor module in selectedModules:\n\t\t\t\t\tif module \u003d\u003d \"EAM\":\n\t\t\t\t\t\tselectedModules.remove(module)\n\t\t\t\t\t\tbreak\n\t\t\tif value[\"eamUnlimited\"][\"UUID\"] \u003d\u003d self.view.params.UUID:\n\t\t\t\teamCost \u003d exchange.architecturebuilder.modules.getEamUnlimited()\n\t\t\t\tcost[\u0027total\u0027] +\u003d eamCost\n\t\treturn cost",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "meta.textOriginal": {
            "binding": {
              "config": {
                "expression": "\"Price after discount. (\" + numberFormat(coalesce({this.custom.price.total}, 0), \"$#,##0.00\") + \" Retail)\""
              },
              "type": "expr"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "config": {
                "expression": "{session.custom.discount} \u003e 0"
              },
              "type": "expr"
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "expression": "{this.custom.price}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.vendor} \u003d \u0027IA\u0027 || {view.params.vendor} \u003d \u0027CL\u0027,\r\n\tif(len({this.custom.price.msg}) \u003e 0,\r\n\t\tnumberFormat({this.custom.price.total} * (1 - ({session.custom.discount} / 100.0)), \u0027$#,##0.00+\u0027),\r\n\t\tnumberFormat({this.custom.price.total} * (1 - ({session.custom.discount} / 100.0)), \u0027$#,##0.00\u0027)),\r\n\t\u0027Quote Required\u0027)"
              },
              "type": "expr"
            }
          },
          "props.textStyle.fontStyle": {
            "binding": {
              "config": {
                "expression": "len({this.custom.price.msg}) \u003e 0"
              },
              "transforms": [
                {
                  "fallback": "normal",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "italic"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "marginLeft": "8px",
            "marginRight": 8,
            "textAlign": "right"
          }
        },
        "scripts": {
