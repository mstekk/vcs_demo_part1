        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\tFalse,\r\n\t{value})",
            "type": "expression"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.entry": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.uuid": {
      "paramDirection": "input",
      "persistent": true
    }
  },
