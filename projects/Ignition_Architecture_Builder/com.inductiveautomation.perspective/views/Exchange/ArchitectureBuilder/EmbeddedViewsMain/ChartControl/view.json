                    "script": "\tif self.session.custom.saveToMongo:\n\t\tconnector\u003dself.view.params.lastLoad.connector\n\t\tcollection\u003dself.view.params.lastLoad.collection\n\t\tfilename\u003dself.view.params.lastLoad.filename\n\t\tmeetingId\u003dself.view.params.lastLoad.meetingId\n\t\tmongoId\u003dself.view.params.lastLoad.id\n\t\tsystem.perspective.sendMessage(\u0027saveArchitecture\u0027, {\u0027connector\u0027:connector,\u0027collection\u0027:collection,\u0027filename\u0027:filename, \u0027meetingId\u0027:meetingId, \u0027id\u0027:mongoId}, scope\u003d\u0027session\u0027)\n\t\tself.custom.lastSave\u003dsystem.date.now()\n\telse:\n\t\timport json\n\t\timport os\n\t\t# Data to be written to the JSON file\n\t\t\n\t\tcollection\u003dself.view.params.lastLoad.collection\n\t\tcomponents\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.components))\n\t\tconnections\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.connections))\n\t\tcontainers\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.containers))\n\t\tconfig\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.structure.configs))\n\t\tcanvasSize\u003dsystem.util.jsonDecode(system.util.jsonEncode(self.session.custom.canvasSize))\n\t\tsaveDate\u003dsystem.date.toMillis(system.date.now())\n\t\tfilename\u003dself.view.params.lastLoad.filename\n\t\t\n\t\tdirectory_path \u003d self.view.params.lastLoad.collection\n\t\tfile_name \u003d filename.replace(\u0027.json\u0027,\u0027\u0027)\n\t\t\n\t\tdata\u003d{\n\t\t\t\t\u0027filename\u0027:file_name,\n\t\t\t\t\u0027meetingId\u0027:\u0027\u0027,\n\t\t\t\t\u0027saveDate\u0027:saveDate,\n\t\t\t\t\u0027components\u0027:components,\n\t\t\t\t\u0027connections\u0027:connections,\n\t\t\t\t\u0027containers\u0027:containers,\n\t\t\t\t\u0027config\u0027:config,\n\t\t\t\t\"canvasSize\":canvasSize}\n\t\n\t\n\t\n\t\ttry:\n\t\t    if not os.path.exists(directory_path):\n\t\t   \t\tos.mkdir(directory_path)\n\t\texcept OSError as e:\n\t\t    system.perspective.print(\"Error: {}\".format(e))\n\t\t# Specify the file path\n\t\tfile_path \u003d \u0027{}/{}.json\u0027.format(directory_path,file_name)\n\t\t# Write the data to a JSON file\n\t\twith open(file_path, \u0027w\u0027) as json_file:\n\t\t    json.dump(data, json_file)\n\t\tmongoLast\u003d{\u0027filename\u0027:file_name+\u0027.json\u0027, \u0027id\u0027:\u0027\u0027, \u0027saveDate\u0027:saveDate,\t\u0027connector\u0027:\u0027\u0027, \u0027collection\u0027:collection, \u0027meetingId\u0027:\u0027\u0027,\u0027canvasSize\u0027:canvasSize}\n\t\tsystem.perspective.sendMessage(\u0027updateLastMongo\u0027, mongoLast, scope\u003d\u0027session\u0027)\n\t\tself.custom.lastSave\u003dsystem.date.now()\n\t\t"
                  },
