                    "script": "\t# if event.enabled:\n\t\t# add your action handling code\n\tif event.label in [\u0027Save...\u0027,\u0027Save As...\u0027]and (not self.session.custom.admin.savingDisabled):\n\t\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\t\tif self.session.custom.saveToMongo:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/SaveArchitectureToMongo\u0027\n\t\telse:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/SaveArchitectureToFileSystem\u0027\n\t\tsystem.perspective.openPopup(\u0027saveArchitecture\u0027, view, params\u003d{\u0027lastLoad\u0027: self.view.params.lastLoad}, title\u003d\"Save Architecture\")\n\telif event.label\u003d\u003d\u0027Open\u0027:\n\t\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\t\tif self.session.custom.saveToMongo:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/LoadArchitectureFromMongo\u0027\n\t\telse:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/LoadArchitectureFromFileSystem\u0027\n\t\t\t\n\t\tsystem.perspective.openPopup(\u0027insertArch\u0027, view, title\u003d\u0027Open Architecture\u0027, params\u003d{\u0027load\u0027: True})\n\telif event.label\u003d\u003d\u0027Manage Files\u0027 and (not self.session.custom.admin.deletingDisabled):\n\t\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\t\tif self.session.custom.saveToMongo:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/FileManagerMongo\u0027\n\t\telse:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/FileManagerFileSystem\u0027\n\t\tsystem.perspective.openPopup(\u0027manageFiles\u0027, view, title\u003d\u0027Manage Files\u0027, params\u003d{\u0027load\u0027: True})\n\t\t\n\telif event.label\u003d\u003d\u0027Insert\u0027:\n\t\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\t\tif self.session.custom.saveToMongo:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/LoadArchitectureFromMongo\u0027\n\t\telse:\n\t\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/LoadArchitectureFromFileSystem\u0027\n\t\tsystem.perspective.openPopup(\u0027insertArch\u0027, view, title\u003d\u0027Insert Architecture\u0027, params\u003d{\u0027load\u0027: False})\n\t\n\telif event.label\u003d\u003d\u0027Delete\u0027 and (not self.session.custom.admin.savingDisabled or \"Administrator\" in self.session.props.auth.user.roles):\n\t\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/DeleteArchitectureFromMongo\u0027\n\t\tsystem.perspective.openPopup(\u0027deleteArchitecture\u0027, view, title\u003d\u0027Delete Architecture\u0027)\n\telif event.label\u003d\u003d\u0027Reset Center\u0027:\n\t\tsystem.perspective.sendMessage(\u0027clearCenterComponents\u0027, True, scope\u003d\u0027session\u0027)\n\t\tsystem.perspective.sendMessage(\u0027panInteract\u0027, {\u0027action\u0027:\u0027Pan\u0027},scope\u003d\u0027session\u0027)\n\telif event.label\u003d\u003d\u0027Clear\u0027:\n\t\tsystem.perspective.sendMessage(\u0027clearCenterComponents\u0027, False, scope\u003d\u0027session\u0027)\n\t\tsystem.perspective.sendMessage(\u0027panInteract\u0027, {\u0027action\u0027:\u0027Pan\u0027},scope\u003d\u0027session\u0027)\n\telif event.label\u003d\u003d\u0027New\u0027:\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/EmbeddedViews/NewPopup\u0027\n\t\tsystem.perspective.openPopup(\u0027saveNew\u0027, view, title\u003d\u0027Save?\u0027, params\u003d{\u0027lastLoad\u0027: self.view.params.lastLoad})\n\t\t\n\telif event.label\u003d\u003d\u0027Snap\u0027:\n\t\tsystem.perspective.sendMessage(\u0027requestSnap\u0027, True, scope\u003d\u0027session\u0027)\n\telif event.label\u003d\u003d\u0027Open BOM\u0027:\n\t\tsystem.perspective.navigate(\u0027/BOM\u0027,newTab\u003dTrue)\n\telif event.label\u003d\u003d\u0027Map\u0027:\n\t\tsystem.perspective.navigate(\u0027/Map\u0027,newTab\u003dTrue)\n\telif event.label\u003d\u003d\u0027JSON Structure\u0027:\n\t\tsystem.perspective.openDock(\"structure\")\n#\t\tsystem.perspective.openPopup(\u0027JSON\u0027, \u0027Exchange/ArchitectureBuilder/StructureViewPrettyPrint\u0027, title\u003d\u0027JSON Structure\u0027, resizable \u003d True, modal\u003dTrue, viewportBound\u003dTrue, position \u003d {\u0027height\u0027: \u0027auto\u0027, \u0027width\u0027: \u0027300px\u0027} )\n\telif event.label\u003d\u003d\u0027JSON Configs\u0027:\n\t\tsystem.perspective.openPopup(\u0027JSON\u0027, \u0027Exchange/ArchitectureBuilder/ConfigViewPrettyPrint\u0027, title\u003d\u0027JSON Configs\u0027, resizable \u003d True, modal\u003dTrue, viewportBound\u003dTrue, position \u003d {\u0027height\u0027: \u002750%\u0027, \u0027width\u0027: \u0027300px\u0027} )\n\telif event.label\u003d\u003d\u0027Email\u0027:\n\t\t#system.perspective.navigate(\u0027/email\u0027,newTab\u003dTrue)\n\t\tsystem.perspective.openPopup(\u0027Email\u0027, \u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/EmailPopUp\u0027, title\u003d\u0027Email\u0027 , resizable\u003dFalse)\n\telif event.label\u003d\u003d\u0027Print\u0027:\n\t\tsystem.perspective.sendMessage(\u0027Print\u0027, True, scope\u003d\u0027session\u0027)\n\telif event.label\u003d\u003d\u0027Export\u0027:\n\t\t#system.perspective.sendMessage(\u0027downloadLayout\u0027, True, scope\u003d\u0027session\u0027)\n\t\tsystem.perspective.openPopup(\"Export\", \"Exchange/ArchitectureBuilder/BOM/Popups/Export\", title\u003d\"Download\", )\n\telif event.label\u003d\u003d\u0027Import\u0027:\n\t\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027, True, scope\u003d\u0027session\u0027)\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/UploadArchitecture\u0027\n\t\tsystem.perspective.openPopup(\u0027uploadArch\u0027, view, title\u003d\u0027Upload Architecture\u0027)\n\telif event.label\u003d\u003d\u0027Enable Module Flyout\u0027 or event.label\u003d\u003d\u0027Disable Module Flyout\u0027:\n\t\tself.session.custom.moduleFlyOut\u003d not self.session.custom.moduleFlyOut\n\telif event.label\u003d\u003d\u0027Show UUID\u0027 or event.label\u003d\u003d\u0027Hide UUID\u0027:\n\t\tself.session.custom.showUUID\u003d not self.session.custom.showUUID\n\telif event.label\u003d\u003d\u0027Click Support\u0027 or event.label\u003d\u003d\u0027Touch Support\u0027:\n\t\tself.session.custom.touch\u003d not self.session.custom.touch\t\n\telif event.label\u003d\u003d\u0027Set Canvas Size\u0027:\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/General/CanvasSize\u0027\n\t\tsystem.perspective.openPopup(\u0027canvasSize\u0027, view, title\u003d\"Modify Canvas Size\")\n\telif event.label\u003d\u003d\u0027Change Grid Size\u0027:\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/SnapPopUp\u0027\n\t\tsystem.perspective.openPopup(\u0027snapPixels\u0027, view, title\u003d\"Modify Snap Pixels\")\n\telif event.label\u003d\u003d\u0027Toggle Grid\u0027:\n\t\tsystem.perspective.sendMessage(\u0027toggleGrid\u0027, True, scope\u003d\u0027session\u0027)\n\telif event.label\u003d\u003d\u0027View/Render\u0027:\n\t\tview\u003d\u0027Exchange/ArchitectureBuilder/EmbeddedViewsMain/EmbeddedViews/RenderingOptions\u0027\n\t\tsystem.perspective.openPopup(\u0027render\u0027, view, params\u003d{}, title\u003d\"Select Components to Show\")\n\telif event.label\u003d\u003d\u0027Configure Connection\u0027:\n\t\tsystem.perspective.sendMessage(\u0027requestConnection\u0027, True, scope\u003d\u0027session\u0027)\n\t\tself.view.custom.display\u003dFalse"
