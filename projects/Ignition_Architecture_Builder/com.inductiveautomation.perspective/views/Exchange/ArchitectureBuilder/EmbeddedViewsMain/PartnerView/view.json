{
  "custom": {},
  "params": {
    "backcolor": "--neutral-90",
    "base64": "data:image/png;base64,",
    "link": "value",
    "name": "value"
  },
  "propConfig": {
    "params.backcolor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.base64": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.link": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 102,
      "width": 145
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Image"
        },
        "position": {
          "basis": "605px",
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.params.base64"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "mode": "contain"
          }
        },
        "type": "ia.display.image"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "newTab": true,
            "url": "{view.params.link}"
          },
          "scope": "C",
          "type": "nav"
        }
      }
    },
    "meta": {
      "name": "root",
      "tooltip": {
        "delay": 1000,
        "enabled": true
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.name"
          },
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.backcolor"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "borderBottomLeftRadius": "32px",
        "borderBottomRightRadius": "32px",
        "borderTopLeftRadius": "32px",
        "borderTopRightRadius": "32px",
        "cursor": "pointer",
        "margin": "4px",
        "overflow": "hidden",
        "padding": "16px"
      }
    },
    "type": "ia.container.flex"
  }
}