{
  "custom": {
    "fileSystem": {
      "path": "/usr/local/bin/ignition/data/savedFiles/Architecture"
    },
    "loadPath": ""
  },
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\texchange.architecturebuilder.files.create_Base_Folders()\n\tfrom com.inductiveautomation.ignition.gateway import IgnitionGateway\n\tcontext \u003d IgnitionGateway.get()\n\tprojectParentFolder \u003d str(context.systemManager.dataDir.absoluteFile).replace(\u0027\\\\\u0027,\u0027/\u0027)\n\tself.custom.fileSystem.path\u003d projectParentFolder+\u0027/savedFiles/Architecture\u0027"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "load": true
  },
  "propConfig": {
    "custom.fileSystem": {
      "persistent": true
    },
    "custom.fileSystem.directories": {
      "binding": {
        "config": {
          "path": "view.custom.fileSystem.path"
        },
        "transforms": [
          {
            "code": "\timport os\n\t\n\tdef list_directories(directory):\n\t    try:\n\t        # Get a list of all items in the directory\n\t        items \u003d os.listdir(directory)\n\t        # Filter out directories from the list\n\t        directories \u003d [item for item in items if os.path.isdir(os.path.join(directory, item))]\n\t        return directories\n\t    except OSError as e:\n\t        print(\"Error listing directories: {}\".format(e))\n\t        return []\n\t\n\t# Specify the directory to browse\n\tdirectories\u003d[]\n\tdirectory \u003d value\n\t\n\t# Get the list of all directories in the directory\n\tdirectory_list \u003d list_directories(directory)\n\t\n\t# Print the directory list\n\tfor directory_name in directory_list:\n\t    directories.append(directory_name)\n\t\n\treturn directories",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.fileSystem.path": {
      "binding": {
        "config": {
          "path": ""
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\tfrom com.inductiveautomation.ignition.gateway import IgnitionGateway\n\tcontext \u003d IgnitionGateway.get()\n\tprojectParentFolder \u003d str(context.systemManager.dataDir.absoluteFile).replace(\u0027\\\\\u0027,\u0027/\u0027)\n\treturn projectParentFolder+\u0027/savedFiles/Architecture\u0027\n",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.load": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize.height": {
      "binding": {
        "config": {
          "expression": "if({view.params.load},330,\r\nif(!{/root/ToggleSwitch.props.selected},330,495))"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 473
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "margin": "8px"
          },
          "text": "Architectures:"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Tree"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "propConfig": {
          "props.items": {
            "binding": {
              "config": {
                "struct": {
                  "directories": "{view.custom.fileSystem.directories}",
                  "parent": "{view.custom.fileSystem.path}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\timport os\n\t\n\tdef list_files(directory):\n\t    try:\n\t        # Get a list of all files in the directory\n\t        files \u003d os.listdir(directory)\n\t        # Filter out directories from the list\n\t        files \u003d [file for file in files if os.path.isfile(os.path.join(directory, file))]\n\t        return files\n\t    except OSError as e:\n\t        print(\"Error listing files: {}\".format(e))\n\t        return []\n\t\n\tdef createTreeItem(filename, directory\u003dNone):\n\t\treturn {\n\t\t  \"label\": filename,\n\t\t  \"expanded\": True,\n\t\t  \"data\": {\u0027filename\u0027: filename, \u0027directory\u0027:directory},\n\t\t  \"items\": []\n\t\t}\n\t\n\tdef createDirItem(directory,parentPath):\n\t\tlisted_files\u003dlist_files(\u0027{}/{}\u0027.format(parentPath,directory))\n\t\titems\u003d[]\n\t\tfor filename in listed_files:\n\t\t\titems.append(createTreeItem(filename,directory))\n\t\treturn {\n\t\t\t  \"label\": directory,\n\t\t\t  \"expanded\": False,\n\t\t\t  \"data\": {\u0027directory\u0027:directory},\n\t\t\t  \"icon\": {\"path\": \"material/folder_open\",\"color\": \"\",\"style\": {}},\n\t\t\t  \"items\": items\n\t\t\t}\n\t\n\tfileStructure\u003d[]\n\tparentPath\u003dvalue[\u0027parent\u0027]\n\n\t\n\tdirectories\u003dvalue[\u0027directories\u0027]\n\tfor directory in directories:\n\t\tfileStructure.append(createDirItem(directory,parentPath))\n\tparentFiles\u003dlist_files(parentPath)\t\n\t\n\tfor filename in parentFiles:\n\t\tfileStructure.append(createTreeItem(filename))\n\t\n\treturn fileStructure\n#\treturn [{\n#\t\t\t  \"label\": \u0027Architectures\u0027,\n#\t\t\t  \"expanded\": True,\n#\t\t\t  \"data\": {\u0027directory\u0027:None},\n#\t\t\t  \"items\": fileStructure\n#\t\t\t}]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.selectionData": {
            "onChange": {
              "enabled": null,
              "script": "\tif len(self.props.selectionData)\u003e0:\n\t\n\t\tselection\u003dself.props.selectionData[0].value\t\n\t\n\t\tif \u0027filename\u0027 in selection.keys():\n\t\t\tparentPath\u003dself.view.custom.fileSystem.path\n\t\t\tdirectory\u003dselection[\u0027directory\u0027]\n\t\t\tfilename\u003dselection[\u0027filename\u0027]\n\t\t\tif directory is None:\n\t\t\t\tself.view.custom.loadPath\u003d\u0027{}/{}\u0027.format(parentPath,filename)\n\t\t\telse:\n\t\t\t\tself.view.custom.loadPath\u003d\u0027{}/{}/{}\u0027.format(parentPath,directory,filename)\n\t\t\t\n\t\telse:\n\t\t\tself.view.custom.loadPath\u003dNone"
            }
          }
        },
        "props": {
          "appearance": {
            "defaultNodeIcons": {
              "collapsed": {
                "path": "material/folder"
              },
              "empty": {
                "color": "--standard",
                "path": "material/insert_drive_file"
              },
              "expanded": {
                "path": "material/folder_open"
              }
            },
            "expandIcons": {
              "collapsed": {
                "path": "material/arrow_right"
              },
              "expanded": {
                "path": "material/arrow_drop_down"
              }
            },
            "selectedStyle": {
              "color": "--edge"
            }
          },
          "style": {
            "marginBottom": "8px",
            "marginLeft": "8px",
            "marginRight": "8px"
          }
        },
        "type": "ia.display.tree"
      },
      {
        "meta": {
          "name": "ToggleSwitch"
        },
        "position": {
          "basis": "36px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{view.params.load}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "label": {
            "text": "Instance Wizard"
          }
        },
        "type": "ia.input.toggle-switch"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027,True)\n\tsystem.perspective.sendMessage(\u0027selectFrame\u0027, {\u0027selected\u0027:True})\n\tsystem.perspective.sendMessage(\u0027loadArchitectureFS\u0027, {\u0027filePath\u0027: self.view.custom.loadPath, \u0027load\u0027:self.view.params.load}, scope\u003d\u0027session\u0027)\n\tsystem.perspective.closePopup(\u0027insertArch\u0027)\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Button"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.load}||!{../ToggleSwitch.props.selected}"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.loadPath}!\u003dnull \u0026\u0026 {view.custom.loadPath}!\u003d\u0027\u0027"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.load"
              },
              "transforms": [
                {
                  "fallback": null,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "Load"
                    },
                    {
                      "input": false,
                      "output": "Insert"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--success",
            "margin": "8px",
            "marginTop": "8px",
            "overflow": "auto"
          }
        },
        "type": "ia.input.button"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "32px",
              "shrink": 0
            },
            "props": {
              "style": {
                "textAlign": "center"
              },
              "text": "Multi-Instance Wizard"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "MultiStateButton"
            },
            "position": {
              "basis": "34px"
            },
            "propConfig": {
              "props.indicatorValue": {
                "binding": {
                  "config": {
                    "path": "this.props.controlValue"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "controlValue": 0,
              "orientation": "row",
              "states": [
                {
                  "selectedStyle": {
                    "backgroundColor": "--callToAction--active",
                    "classes": ""
                  },
                  "text": "Horizontal",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 0
                },
                {
                  "selectedStyle": {
                    "backgroundColor": "--callToAction--active",
                    "classes": ""
                  },
                  "text": "Vertical",
                  "unselectedStyle": {
                    "classes": ""
                  },
                  "value": 1
                }
              ],
              "style": {
                "margin": "8px"
              }
            },
            "type": "ia.input.multi-state-button"
          },
          {
            "meta": {
              "name": "Instances"
            },
            "props": {
              "params": {
                "label": "Instances:",
                "labelSize": 170,
                "value": 2
              },
              "path": "Exchange/ArchitectureBuilder/General/NumericInput",
              "style": {
                "margin": "8px"
              }
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Spacing"
            },
            "props": {
              "params": {
                "label": "Instance Spacing (px):",
                "labelSize": 170,
                "value": 20
              },
              "path": "Exchange/ArchitectureBuilder/General/NumericInput",
              "style": {
                "margin": "8px"
              }
            },
            "type": "ia.display.view"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(\u0027cancelConfigs\u0027,True)\n\tsystem.perspective.sendMessage(\u0027selectFrame\u0027, {\u0027selected\u0027:True})\n\t#connector\u003d self.parent.parent.getChild(\"Connectors\").getChild(\"Connectors\").props.value\n\t#collection\u003dself.parent.parent.getChild(\"Collections\").getChild(\"Collectios\").props.value\n\t#docId\u003dself.parent.parent.getChild(\"File\").getChild(\"File\").props.value\n\tsystem.perspective.sendMessage(\u0027multiInstanceArchitectureFS\u0027, {\u0027filePath\u0027: self.view.custom.loadPath, \u0027load\u0027:self.view.params.load, \u0027instances\u0027: self.getSibling(\"Instances\").props.params.value, \u0027spacing\u0027: self.getSibling(\"Spacing\").props.params.value, \u0027direction\u0027: self.getSibling(\"MultiStateButton\").props.controlValue}, scope\u003d\u0027session\u0027)\n\tsystem.perspective.closePopup(\u0027insertArch\u0027)\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.loadPath}!\u003dNull"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "margin": "8px",
                "marginTop": "8px",
                "overflow": "auto"
              },
              "text": "Insert"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "root"
        },
        "position": {
          "display": false,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{../ToggleSwitch.props.selected}"
              },
              "type": "expr"
            },
            "persistent": true
          }
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}