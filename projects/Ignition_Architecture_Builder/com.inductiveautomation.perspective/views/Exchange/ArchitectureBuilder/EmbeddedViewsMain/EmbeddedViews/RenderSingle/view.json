{
  "custom": {
    "key": "value"
  },
  "params": {
    "enabled": true,
    "nameOverride": false,
    "type": "fourIR"
  },
  "propConfig": {
    "custom.key": {
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.nameOverride": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.type": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 44,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "30px"
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "red",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "green"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "transforms": [
                {
                  "fallback": "material/not_interested",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "material/check"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginLeft": "4px",
            "marginRight": "4px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "50px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.type"
              },
              "transforms": [
                {
                  "code": "\tif self.view.params.nameOverride:\n\t\treturn value\n\telse:\n\t\treturn exchange.architecturebuilder.viewCanvas.connectionRules.getConnectionName(value)+\u0027s\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tself.view.params.enabled\u003dnot self.view.params.enabled"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "--neutral-50",
        "borderBottomLeftRadius": "8px",
        "borderBottomRightRadius": "8px",
        "borderTopLeftRadius": "8px",
        "borderTopRightRadius": "8px",
        "cursor": "pointer"
      }
    },
    "type": "ia.container.flex"
  }
}