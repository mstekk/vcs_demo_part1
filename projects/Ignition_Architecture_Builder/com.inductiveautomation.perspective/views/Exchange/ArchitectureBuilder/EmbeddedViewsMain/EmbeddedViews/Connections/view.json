                {
                  "code": "\tif not value[\u0027message\u0027]:\n\t\treturn value[\u0027message\u0027] \n\telif not value[\u0027eConnect\u0027]:\n\t\treturn value[\u0027eConnect\u0027]\t\n\telse:\n\t\tif len(value[\u0027connection\u0027])!\u003d2:\n\t\t\treturn False\n\t\telif value[\u0027connection\u0027][0][\u0027uuid\u0027]!\u003dvalue[\u0027connection\u0027][1][\u0027uuid\u0027]:\t\n\t\t\treturn True\n\t\telse:\n\t\t\treturn False",
