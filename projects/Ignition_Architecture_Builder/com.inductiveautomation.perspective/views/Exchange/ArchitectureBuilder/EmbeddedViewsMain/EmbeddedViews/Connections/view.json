          "messageType": "requestConnection",
          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027requestConnection\u0027, True)\n\tself.session.custom.rendering.connections\u003dTrue\n\tif self.session.custom.requestConnection\u003d\u003dFalse:\n\t\tself.session.custom.requestConnection\u003dTrue\n\t\tsystem.perspective.sendMessage(\u0027panInteract\u0027, {\u0027action\u0027:\u0027Interact\u0027},scope\u003d\u0027session\u0027)\n\telif len(self.view.custom.connection)!\u003d2:\n\t\tself.session.custom.requestConnection\u003dFalse\n\t\tself.view.custom.connection\u003d[]\n\telse:\n\t\tif self.view.custom.allowConnection.allow and self.view.custom.preDefinedConnections.allow:\n\t\t\tconnection\u003d{}\n\t\t\tconfig\u003d{}\n\t\t\tconnectionType\u003dself.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\n\t\t\toutgoing\u003dself.getChild(\"GatewayNetwork\").getChild(\"RadioGroup\").props.value\n\t\t\tlineType\u003dself.getChild(\"ConnectionType\").getChild(\"RadioGroup\").props.value\n\t\t\t\n\t\t\tconfig[\u0027connectionType\u0027]\u003dconnectionType\n\t\t\tif connectionType\u003d\u003d\u0027Gateway Network\u0027:\n\t\t\t\tconfig[\u0027Outgoing\u0027]\u003doutgoing\n\t\t\tconfig[\u0027lineType\u0027]\u003dlineType\n\t\t\tuuid\u003dexchange.architecturebuilder.uuid.newUuid()\n\t\t\tc0uuid\u003dself.view.custom.connection[0].uuid\n\t\t\tc0x\u003dself.view.custom.connection[0].x\n\t\t\tc0y\u003dself.view.custom.connection[0].y\n\t\t\tc1uuid\u003dself.view.custom.connection[1].uuid\n\t\t\tc1x\u003dself.view.custom.connection[1].x\n\t\t\tc1y\u003dself.view.custom.connection[1].y\n\t\t\tparams\u003d{\n\t\t\t\t\t  \"name\": \"Connection\",\n\t\t\t\t\t  \"type\": \"Connection\",\n\t\t\t\t\t  \"uuid\": uuid,\n\t\t\t\t\t  \"config\": config,\n\t\t\t\t\t  \"desc\": \"\"\n\t\t\t\t\t}\n\t\t\t\t\n\t\t\tself.session.custom.connections[uuid]\u003d{c0uuid: {\u0027x\u0027: c0x, \u0027y\u0027: c0y},c1uuid: {\u0027x\u0027: c1x, \u0027y\u0027: c1y}}\n\t\t\tself.session.custom.structure.configs[uuid]\u003dparams\n\t\t\t\n\t\t\tif \u0027connections\u0027 in self.session.custom.structure.configs[c0uuid][\u0027config\u0027]:\n\t\t\t\tself.session.custom.structure.configs[c0uuid][\u0027config\u0027][\u0027connections\u0027].append(uuid)\n\t\t\telse:\n\t\t\t\tself.session.custom.structure.configs[c0uuid][\u0027config\u0027][\u0027connections\u0027]\u003d[uuid]\n\t\t\tif \u0027connections\u0027 in self.session.custom.structure.configs[c1uuid][\u0027config\u0027]:\n\t\t\t\tself.session.custom.structure.configs[c1uuid][\u0027config\u0027][\u0027connections\u0027].append(uuid)\n\t\t\telse:\n\t\t\t\tself.session.custom.structure.configs[c1uuid][\u0027config\u0027][\u0027connections\u0027]\u003d[uuid]\n\t\t\t\t\n\t\t\tself.session.custom.requestConnection\u003dFalse",
          "sessionScope": true,
          "viewScope": false
        },
        {
          "messageType": "cancelConfigs",
          "pageScope": false,
          "script": "\twarning\u003dself.getChild(\"SelectedConnections\").getChild(\"FlexContainer\")\n\tself.view.custom.addConnection\u003dFalse",
          "sessionScope": true,
          "viewScope": false
        },
        {
          "messageType": "connectionEnabledStatus",
          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027connectionEnabledStatus\u0027, scope\u003d\u0027session\u0027)\n\tself.view.custom.addConnection\u003dFalse\n\t#system.perspective.sendMessage(\u0027connectionEnabled\u0027, {\u0027connect\u0027:self.props.selected}, scope\u003d\u0027session\u0027)",
          "sessionScope": false,
          "viewScope": false
        }
      ]
