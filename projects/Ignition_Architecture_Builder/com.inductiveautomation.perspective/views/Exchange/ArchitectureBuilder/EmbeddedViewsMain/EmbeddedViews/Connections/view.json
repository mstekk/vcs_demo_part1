  "propConfig": {
    "custom.addConnection": {
      "binding": {
        "config": {
          "path": "session.custom.requestConnection"
        },
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\tsystem.perspective.sendMessage(\u0027connectionEnabled\u0027, {\u0027connect\u0027:currentValue.value}, scope\u003d\u0027session\u0027)\n\tself.custom.connection\u003d[]"
      },
      "persistent": true
    },
    "custom.allowConnection": {
      "binding": {
        "config": {
          "path": "view.custom.connection"
        },
        "transforms": [
          {
            "code": "\tavailiblevalue\u003d[]\n\tconnectionTypes\u003d[]\n\toptions\u003d[]\n\tconnections\u003d{\u0027allow\u0027: True, \u0027limited\u0027: False, \u0027approval\u0027: False, \u0027message\u0027: \u0027\u0027}\n\tif len(value)\u003d\u003d2:\n\t\tfor connection in value:\n\t\t\tconnectionTypes.append(connection[\u0027type\u0027])\n\t\tconnections\u003dexchange.architecturebuilder.viewCanvas.connectionRules.connectionCheck(connectionTypes)\n\treturn connections\n#\t\t#return connectionTypes\n#\t\t#Test GWN Connection\n#\t\tavailibleGWCs\u003d[\u0027standard\u0027, \u0027cloud\u0027,\u0027edge\u0027,\u0027panel\u0027]\n#\t\tif connectionTypes[0] in availibleGWCs and connectionTypes[1] in availibleGWCs:\n#\t\t\t#self.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\u003d\u0027Gateway Network\u0027\n#\t\t\tavailiblevalue.append(\u0027Gateway Network\u0027)\n#\t\t\n#\t\tavailibleDeviceCs\u003d[\u0027standard\u0027,\u0027edge\u0027, \u0027panel\u0027]\n#\t\tif (\u0027Device\u0027 in connectionTypes or (connectionTypes[0] in availibleDeviceCs and connectionTypes[1] in availibleDeviceCs)) and (connectionTypes[0] in availibleDeviceCs or connectionTypes[1] in availibleDeviceCs):\n#\t\t\tavailiblevalue.append(\u0027OPCDevice\u0027)\t\n#\t\t\t\n#\t\t\t\n#\t\tavailibleStandards\u003d[\u0027standard\u0027,\u0027edge\u0027, \u0027panel\u0027,\u0027cloud\u0027, \u0027Connector\u0027, \u0027MongoDB\u0027, \u0027Load Balancer\u0027, \u0027Comms\u0027, \u0027Client\u0027]\n#\t\tif connectionTypes[0] in availibleStandards and connectionTypes[1] in availibleStandards:\n#\t\t\t#self.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\u003d\u0027Gateway Network\u0027\n#\t\t\tavailiblevalue.append(\u0027Standard\u0027)\t\t\n#\t\t\n#\t\tavailibleMQTTCs\u003d[\u0027standard\u0027,\u0027edge\u0027, \u0027panel\u0027,\u0027cloud\u0027, \u0027Connector\u0027, \u0027Device\u0027, \u0027Comms\u0027]\n#\t\tif connectionTypes[0] in availibleMQTTCs and connectionTypes[1] in availibleMQTTCs:\n#\t\t\t#self.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\u003d\u0027Gateway Network\u0027\n#\t\t\tavailiblevalue.append(\u0027MQTT\u0027)\t\t\n#\t\t\t\n#\t\tavailibleDBCs\u003d[\u0027standard\u0027,\u0027cloud\u0027]\n#\t\tif \u0027Database\u0027 in connectionTypes and (connectionTypes[0] in availibleDBCs or connectionTypes[1] in availibleDBCs):\n#\t\t\tavailiblevalue.append(\u0027DB\u0027)\n#\t\n#\t\t#Test Device Connection\n#\n#\t\t\n#\t\t\t\n#\t\tfor option in availiblevalue:\t\t\t\n#\t\t\toptions.append({\n#\t\t\t\t  \"value\": option,\n#\t\t\t\t  \"label\": option\n#\t\t\t\t})\t\n#\t\t\n#\treturn options",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.availibleConnections": {
      "binding": {
        "config": {
          "path": "view.custom.connection"
        },
        "transforms": [
          {
            "code": "\tavailiblevalue\u003d[]\n\tconnectionTypes\u003d[]\n\toptions\u003d[]\n\tif len(value)\u003d\u003d2:\n\t\tfor connection in value:\n\t\t\tconnectionTypes.append(connection[\u0027type\u0027])\n\t\t\t\n\treturn exchange.architecturebuilder.viewCanvas.connectionRules.availibleConnections(connectionTypes)\n#\t\t#return connectionTypes\n#\t\t#Test GWN Connection\n#\t\tavailibleGWCs\u003d[\u0027standard\u0027, \u0027cloud\u0027,\u0027edge\u0027,\u0027panel\u0027]\n#\t\tif connectionTypes[0] in availibleGWCs and connectionTypes[1] in availibleGWCs:\n#\t\t\t#self.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\u003d\u0027Gateway Network\u0027\n#\t\t\tavailiblevalue.append(\u0027Gateway Network\u0027)\n#\t\t\n#\t\tavailibleDeviceCs\u003d[\u0027standard\u0027,\u0027edge\u0027, \u0027panel\u0027]\n#\t\tif (\u0027Device\u0027 in connectionTypes or (connectionTypes[0] in availibleDeviceCs and connectionTypes[1] in availibleDeviceCs)) and (connectionTypes[0] in availibleDeviceCs or connectionTypes[1] in availibleDeviceCs):\n#\t\t\tavailiblevalue.append(\u0027OPCDevice\u0027)\t\n#\t\t\t\n#\t\t\t\n#\t\tavailibleStandards\u003d[\u0027standard\u0027,\u0027edge\u0027, \u0027panel\u0027,\u0027cloud\u0027, \u0027Connector\u0027, \u0027MongoDB\u0027, \u0027Load Balancer\u0027, \u0027Comms\u0027, \u0027Client\u0027]\n#\t\tif connectionTypes[0] in availibleStandards and connectionTypes[1] in availibleStandards:\n#\t\t\t#self.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\u003d\u0027Gateway Network\u0027\n#\t\t\tavailiblevalue.append(\u0027Standard\u0027)\t\t\n#\t\t\n#\t\tavailibleMQTTCs\u003d[\u0027standard\u0027,\u0027edge\u0027, \u0027panel\u0027,\u0027cloud\u0027, \u0027Connector\u0027, \u0027Device\u0027, \u0027Comms\u0027]\n#\t\tif connectionTypes[0] in availibleMQTTCs and connectionTypes[1] in availibleMQTTCs:\n#\t\t\t#self.getChild(\"ConnectionType\").getChild(\"Dropdown\").props.value\u003d\u0027Gateway Network\u0027\n#\t\t\tavailiblevalue.append(\u0027MQTT\u0027)\t\t\n#\t\t\t\n#\t\tavailibleDBCs\u003d[\u0027standard\u0027,\u0027cloud\u0027]\n#\t\tif \u0027Database\u0027 in connectionTypes and (connectionTypes[0] in availibleDBCs or connectionTypes[1] in availibleDBCs):\n#\t\t\tavailiblevalue.append(\u0027DB\u0027)\n#\t\n#\t\t#Test Device Connection\n#\n#\t\t\n#\t\t\t\n#\t\tfor option in availiblevalue:\t\t\t\n#\t\t\toptions.append({\n#\t\t\t\t  \"value\": option,\n#\t\t\t\t  \"label\": option\n#\t\t\t\t})\t\n#\t\t\n#\treturn options",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.connection": {
      "persistent": true
    },
    "custom.establishedConnections": {
      "binding": {
        "config": {
          "struct": {
            "configs": "{session.custom.structure.configs}",
            "connection": "{view.custom.connection}",
            "connections": "{session.custom.connections}",
            "uuid": "{view.params.uuid}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tconnection\u003dvalue[\u0027connection\u0027]\n\tconnections\u003dvalue[\u0027connections\u0027]\n\testablishedConnections\u003d[]\n\tif len(value[\u0027connection\u0027])\u003d\u003d2:\n\t\tuuid0\u003dconnection[0][\u0027uuid\u0027]\n\t\tuuid1\u003dconnection[1][\u0027uuid\u0027]\n\t\tfor x in connections:\n\t\t\tif uuid0 in connections[x].keys() and uuid1 in connections[x].keys():\n\t\t\t\testablishedConnections.append(value[\u0027configs\u0027][x][\u0027config\u0027][\u0027connectionType\u0027])\n\treturn establishedConnections\n\t\t\t\t",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.pinned": {
      "persistent": true
    },
    "custom.preDefinedConnections": {
      "binding": {
        "config": {
          "struct": {
            "defined": "{/root/ConnectionType/Dropdown.props.value}",
            "established": "{view.custom.establishedConnections}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn exchange.architecturebuilder.viewCanvas.connectionRules.preEstablishedConnectionRules(value[\u0027defined\u0027], value[\u0027established\u0027])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
