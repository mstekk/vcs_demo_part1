          "pageScope": true,
          "script": "\t#system.perspective.sendMessage(\u0027connectionPath\u0027, {\u0027uuid\u0027: self.view.params.params.uuid, \u0027type\u0027: self.view.params.params.type, \u0027x\u0027: x,\u0027y\u0027: y} ,scope\u003d\u0027session\u0027)\n\tconnections\u003dself.view.custom.connection\n\t\n\tif len(connections)\u003c2:\n\t\tself.view.custom.connection.append(payload)\n\telse:\n\t\tself.view.custom.connection\u003d[payload]\n\t\n\n\n",
