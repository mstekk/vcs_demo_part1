{
  "custom": {},
  "params": {
    "dataForIframe": {
      "action": "",
      "fit": "",
      "zoomin": "",
      "zoomlevel": "",
      "zoomout": ""
    },
    "inputs": {
      "detailedBreakpoint": 1.1,
      "height": "25000px",
      "targetDetailedURL": "/viewCanvas",
      "targetURL": "/viewCanvas",
      "width": "25000px"
    }
  },
  "propConfig": {
    "params.dataForIframe": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.inputs": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "domId": "iframe",
          "name": "IFrame"
        },
        "position": {
          "height": "100%",
          "width": "100%"
        },
        "propConfig": {
          "props.src": {
            "binding": {
              "config": {
                "struct": {
                  "address": "{session.props.gateway.address}",
                  "inputs": "{view.params.inputs}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tendpoint \u003d \u0027{gatewayAddress}/system/webdev/{projectName}/exchange/pan-zoom-iframe/html?gatewayAddress\u003d{gatewayAddress}\u0026projectName\u003d{projectName}\u0026targetURL\u003d{targetURL}\u0026targetDetailedURL\u003d{targetDetailedURL}\u0026height\u003d{height}\u0026width\u003d{width}\u0026detailedBreakpoint\u003d{detailedBreakpoint}\u0027\n\tif value[\u0027address\u0027] is None:\n\t\tgatewayAddress \u003d system.util.getGatewayAddress()\n\telse:\n\t\tgatewayAddress \u003d value[\u0027address\u0027]\n\tprops \u003d {\n\t\t\t  \u0027gatewayAddress\u0027: gatewayAddress\n\t\t\t, \u0027projectName\u0027: system.util.getProjectName()\n\t\t\t, \u0027targetURL\u0027: value[\u0027inputs\u0027][\u0027targetURL\u0027]\n\t\t\t, \u0027targetDetailedURL\u0027 : value[\u0027inputs\u0027][\u0027targetDetailedURL\u0027]\n\t\t\t, \u0027height\u0027: str(value[\u0027inputs\u0027][\u0027height\u0027]).replace(\u0027%\u0027,\u0027%25\u0027)\n\t\t\t, \u0027width\u0027 : str(value[\u0027inputs\u0027][\u0027width\u0027]).replace(\u0027%\u0027,\u0027%25\u0027)\n\t\t\t, \u0027detailedBreakpoint\u0027 : value[\u0027inputs\u0027][\u0027detailedBreakpoint\u0027]\n\t}\n\treturn endpoint.format(**props)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "allowFullScreen": true,
          "referrerPolicy": "unsafe-url",
          "style": {
            "touch-action": "none"
          }
        },
        "type": "ia.display.iframe"
      },
      {
        "meta": {
          "name": "DataForIframe",
          "visible": false
        },
        "position": {
          "height": "20%",
          "width": 592,
          "x": 49,
          "y": 334.5
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.dataForIframe"
              },
              "transforms": [
                {
                  "code": "\treturn system.util.jsonEncode(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "data-for-iframe",
            "overflow": "hidden"
          }
        },
        "type": "ia.input.text-area"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "overflow": "hidden",
        "touch-action": "none"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "pan-zoom-iframe-clicked",
          "pageScope": true,
          "script": "\tif \u0027command\u0027 in payload:\n\t\tif payload[\u0027command\u0027].lower() \u003d\u003d \u0027openpopup\u0027:\n\t\t\tif int(self.page.props.dimensions.viewport.width) \u003c\u003d int(self.session.custom.breakpoint):\n\t\t\t\tpayload[\u0027parameters\u0027][\u0027position\u0027] \u003d {\"width\": \"100%\", \"height\": \"100%\"}\n\t\t\t\tpayload[\u0027parameters\u0027][\u0027params\u0027][\u0027mobile\u0027] \u003d True\n\t\t\t\tpayload[\u0027parameters\u0027][\u0027resizable\u0027] \u003d False\n\t\t\t\tpayload[\u0027parameters\u0027][\u0027draggable\u0027] \u003d False\n\t\t\tsystem.perspective.openPopup(**payload[\u0027parameters\u0027])\t\t\n\t\t\tsystem.perspective.closePopup(payload[\u0027parameters\u0027][\u0027id\u0027], pageId \u003d payload[\u0027self\u0027].view.page.id)",
          "sessionScope": true,
          "viewScope": true
        }
      ]
    },
    "type": "ia.container.coord"
  }
}