  "propConfig": {
    "custom.ApiKey": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]HomeAutomation/Weather/Config/ApiKey"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Locations": {
      "binding": {
        "config": {
          "bidirectional": true,
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]HomeAutomation/Weather/Locations/SavedLocation"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Unit": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]HomeAutomation/Weather/Config/Units"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Weather": {
      "binding": {
        "config": {
          "expression": "now({[default]HomeAutomation/Weather/Config/RefreshRate}*60000)"
        },
        "transforms": [
          {
            "code": "\tlat \u003d self.params.Lat\n\tlng \u003d self.params.Lon\n\tApiKey \u003d self.custom.ApiKey\n\tUnits \u003d self.custom.Unit\n\turl \u003d \"https://api.openweathermap.org/data/2.5/onecall?lat\u003d%s\u0026lon\u003d%s\u0026units\u003d%s\u0026exclude\u003dhourly,minutely,alerts\u0026appid\u003d%s\" % (lat,lng,Units,ApiKey)\n\t\n\tres \u003d system.net.httpGet(url)\n\t\n\treturn system.util.jsonDecode(res)",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.Country": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Lat": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Lon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.index": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 58,
      "width": 280
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "lblName"
            },
            "position": {
              "basis": "85px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.Name} + \", \" + {view.params.Country}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontWeight": "bold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "icon"
            },
            "position": {
              "basis": "50px",
              "shrink": 0
            },
            "propConfig": {
              "props.params.code": {
                "binding": {
                  "config": {
                    "path": "view.custom.Weather.current.weather[0].id"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "path": "Embedded/Weather/icon",
              "useDefaultViewWidth": true
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "lblTemp"
            },
            "position": {
              "basis": "43px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.Weather.current.temp"
                  },
                  "transforms": [
                    {
                      "formatType": "numeric",
                      "formatValue": "##.#",
                      "type": "format"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "fontWeight": "bold",
                "textAlign": "right"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "lblTemp_0"
            },
            "props": {
              "style": {
                "fontWeight": "bold",
                "textAlign": "left"
              },
              "text": "°"
            },
            "type": "ia.display.label"
          }
        ],
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tmessageType\u003d \"getDetails\"\n\tpayload \u003d {\u0027country\u0027:self.view.params.Country,\n\t\t\t\t\u0027name\u0027:self.view.params.Name,\n\t\t\t\t\u0027weather\u0027:self.view.custom.Weather}\n\tsystem.perspective.sendMessage(messageType, payload)\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "flxData"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "justify": "space-between"
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tds \u003d self.view.custom.Locations\n\tindex \u003d self.view.params.index\n\tnewds \u003d system.dataset.deleteRow(ds, index)\n\tself.view.custom.Locations \u003d newds\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "icnDel"
        },
        "position": {
          "basis": "30px"
        },
        "props": {
          "path": "material/delete_outline"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "justify": "space-between",
      "style": {
        "border": "1px solid var(--neutral-40)",
        "border-radius": "4px",
        "margin": "5px 10px"
      }
    },
    "type": "ia.container.flex"
  }
}