              "transforms": [
                {
                  "expression": "!{value}",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.Locations"
              },
              "transforms": [
                {
                  "code": "\tlocations \u003d [\n\t\t{\n\t\t\t\u0027Name\u0027:Name,\n\t\t\t\u0027Lat\u0027:Lat,\n\t\t\t\"Lon\":Lon,\n\t\t\t\"Country\":Country,\n\t\t\t\"Continent\":Continent\n\t\t} for Name,Lat,Lon,Country,Continent in system.dataset.toPyDataSet(value)\n\t]\n\t\n\treturn locations",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "path": "Embedded/Locations/Location",
          "style": {
            "margin": "10px"
          },
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "events": {
