                "type": "ia.input.text-field"
              },
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tif not self.parent.parent.parent.getChild(\"flxSearch\").custom.searching:\n\t\ttagValues \u003d system.tag.readBlocking([\"[default]HomeAutomation/Weather/Locations/ApiKey\"])\n\t\tApiKey \u003d tagValues[0].value\n\t\tlocation \u003d self.getSibling(\"tfdSearch\").props.text\n\t\turl \u003d \"http://api.positionstack.com/v1/forward?access_key\u003d%s\u0026query\u003d%s\" % (ApiKey,location)\n\t\t\n\t\tself.parent.parent.parent.getChild(\"flxSearch\").custom.searching \u003d True\n\t\tres \u003d system.net.httpGet(url)\n\t\t\n\t\tself.parent.parent.parent.getChild(\"flxSearch\").custom.key \u003d res\n\t\tself.parent.parent.parent.getChild(\"flxSearch\").custom.locationData \u003d system.util.jsonDecode(res)\n\t\tself.parent.parent.parent.getChild(\"flxSearch\").custom.searching \u003d False"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "icnSearch"
                },
                "position": {
                  "basis": "30px"
                },
                "props": {
                  "path": "material/search",
                  "style": {
                    "margin": "5px"
                  }
                },
