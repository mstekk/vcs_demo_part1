          }
        },
        "props": {
          "params": {
            "icon": "cloud_circle"
          },
          "path": "Embedded/Title",
          "style": {
            "backgroundColor": ""
          }
        },
        "type": "ia.display.view"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "sgTemp"
                },
                "position": {
                  "basis": "160px"
                },
                "propConfig": {
                  "props.arc.color": {
                    "binding": {
                      "config": {
                        "path": "this.props.value"
                      },
                      "transforms": [
                        {
                          "fallback": "#FFFF00",
                          "inputType": "range",
                          "mappings": [
                            {
                              "input": {
                                "max": 32,
                                "min": -45
                              },
                              "output": "#149ECE"
                            },
                            {
                              "input": {
                                "max": 60,
                                "min": 32
                              },
                              "output": "#14EABF"
                            },
                            {
                              "input": {
                                "max": 85,
                                "min": 65
                              },
                              "output": "#22DC14"
                            },
                            {
                              "input": {
                                "max": 120,
                                "min": 85
                              },
                              "output": "#FA1203"
                            }
                          ],
                          "outputType": "color",
                          "type": "map"
                        }
                      ],
                      "type": "property"
                    }
                  },
                  "props.label.units": {
                    "binding": {
                      "config": {
                        "fallbackDelay": 2.5,
                        "mode": "direct",
                        "tagPath": "[default]HomeAutomation/Weather/Config/Units"
                      },
                      "transforms": [
                        {
                          "fallback": "°F",
                          "inputType": "scalar",
                          "mappings": [
                            {
                              "input": "metric",
                              "output": "°C"
                            }
                          ],
                          "outputType": "scalar",
                          "type": "map"
                        }
                      ],
                      "type": "tag"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "view.params.Weather.current.temp"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "arc": {
                    "cornerRadius": 7,
                    "width": 12
                  },
                  "endAngle": 405,
                  "label": {
                    "maxDecimal": 0
                  },
                  "maxValue": 125,
                  "minValue": -45,
                  "startAngle": 135,
                  "style": {
                    "classes": []
                  }
