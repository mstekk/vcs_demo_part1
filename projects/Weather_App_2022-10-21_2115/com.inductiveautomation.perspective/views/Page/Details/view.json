      },
      {
        "meta": {
          "name": "Carousel"
        },
        "position": {
          "basis": "200px"
        },
        "propConfig": {
          "props.views": {
            "binding": {
              "config": {
                "path": "view.params.Weather.daily"
              },
              "transforms": [
                {
                  "code": "\tviews \u003d []\n\tviewName \u003d \"Embedded/Weather/Daily Forecast\"\n\tidx \u003d 0\n\tfor day in value:\n\t\tview \u003d {\n\t\t  \"viewPath\": viewName,\n\t\t  \"viewParams\": {\n\t\t    \"day\": idx,\n\t\t    \"Weather\":day \n\t\t  },\n\t\t  \"direction\": \"row\",\n\t\t  \"justify\": \"flex-start\",\n\t\t  \"alignItems\": \"flex-start\"\n\t\t}\n\t\tidx +\u003d1\n\t\tviews.append(view)\n\treturn views",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderTopStyle": "solid",
            "borderTopWidth": 1
          }
        },
        "type": "ia.display.carousel"
      }
