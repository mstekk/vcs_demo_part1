                  "basis": "40px",
                  "shrink": 0
                },
                "type": "ia.container.flex"
              },
              {
                "children": [
                  {
                    "meta": {
                      "name": "lblWeatherDesc"
                    },
                    "position": {
                      "basis": "157px"
                    },
                    "propConfig": {
                      "custom.dirText": {
                        "binding": {
                          "config": {
                            "path": "view.params.Weather.current.wind_deg"
                          },
                          "transforms": [
                            {
                              "code": "\n\tval\u003dint((float(value)/22.5)+.5)\n\tarr\u003d[\"N\",\"NNE\",\"NE\",\"ENE\",\"E\",\"ESE\", \"SE\", \"SSE\",\"S\",\"SSW\",\"SW\",\"WSW\",\"W\",\"WNW\",\"NW\",\"NNW\"]\n\treturn arr[(val % 16)]",
                              "type": "script"
                            }
                          ],
                          "type": "property"
                        }
                      },
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "\"Winds \" + toStr({view.params.Weather.current.wind_speed}) +  \u0027 \u0027 + {this.custom.dirText}"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "paddingLeft": 5,
                        "textAlign": "left"
                      }
                    },
                    "type": "ia.display.label"
                  }
                ],
                "meta": {
                  "name": "flxWinds"
                },
                "position": {
                  "basis": "40px",
                  "shrink": 0
                },
                "type": "ia.container.flex"
              },
              {
                "children": [
                  {
                    "meta": {
                      "name": "lblWeatherDesc"
                    },
                    "position": {
                      "basis": "100%",
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "{view.params.Weather.current.sunrise}"
                          },
                          "transforms": [
                            {
                              "expression": "toInt({value})*1000",
                              "type": "expression"
                            },
                            {
                              "formatType": "datetime",
                              "formatValue": {
                                "time": "medium"
                              },
                              "type": "format"
                            },
                            {
                              "expression": "\"Sunrise \" + {value}",
                              "type": "expression"
                            }
                          ],
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "style": {
                        "paddingLeft": 5,
                        "textAlign": "left"
